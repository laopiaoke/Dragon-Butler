<Window x:Class="CoordinatorProbe.HomePrototype"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新首屏原型" Width="980" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ProtoPrimary" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProtoGhost" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="14,0"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Quiet" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="一条龙管家" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="11,4">
                                <TextBlock Text="深色" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                            <Border Padding="11,4">
                                <TextBlock Text="浅色" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,2,16,16">

                    <!-- 主卡：一个卡四种状态 -->
                    <Border CornerRadius="14" Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20,18,20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="HeroLeft"/>
                            <StackPanel x:Name="HeroRight" Grid.Column="1" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right" Orientation="Horizontal"/>
                        </Grid>
                    </Border>

                    <!-- 今天要跑什么 -->
                    <Grid Margin="4,20,4,8">
                        <TextBlock Text="今天要跑什么" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="按日计划" Style="{StaticResource Quiet}"/>
                            <Button Content="编辑顺序" Style="{StaticResource Quiet}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="12" Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0,4">
                        <StackPanel x:Name="QueueHost"/>
                    </Border>

                    <!-- 三张小卡 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TileA" Grid.Column="0" CornerRadius="12" Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,11"/>
                        <Border x:Name="TileB" Grid.Column="2" CornerRadius="12" Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,11"/>
                        <Border x:Name="TileC" Grid.Column="4" CornerRadius="12" Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,11"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
