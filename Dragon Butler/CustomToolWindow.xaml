<Window x:Class="DragonButler.CustomToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义工具" Width="640" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource InsetBrush}" CornerRadius="6"
                                Height="30" Padding="12,0" Margin="0,0,8,0">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource BrandBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Margin="12" CornerRadius="14" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="自定义工具" FontSize="13.5" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="✕" Width="38" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0"
                        Style="{StaticResource CloseBtn}" Click="BtnClose_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="600">
                <StackPanel Margin="18,0,18,4">
                    <TextBlock Text="显示名称" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TbName" Style="{StaticResource Field}" MaxLength="24"/>
                    <TextBlock Text="工具卡和队列里显示的名字，例如「星铁助手」。" Style="{StaticResource Hint}"/>

                    <TextBlock Text="程序位置" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TbPath" Style="{StaticResource Field}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Ghost}" Height="32"
                                Margin="8,0,0,0" Padding="14,0" Click="BtnBrowse_Click"/>
                    </Grid>
                    <TextBlock x:Name="TbPathHint" Text="选择要接管的 exe；图标会自动提取。"
                               Style="{StaticResource Hint}"/>

                    <TextBlock Text="启动参数（可选）" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TbArgs" Style="{StaticResource Field}"/>
                    <TextBlock Text="原样传给程序；不需要就留空。" Style="{StaticResource Hint}"/>

                    <TextBlock Text="进程名" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TbProcess" Style="{StaticResource Field}"/>
                    <TextBlock Text="用来判断程序是否在运行，通常与 exe 同名，不含 .exe。" Style="{StaticResource Hint}"/>

                    <TextBlock Text="完成方式" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbExit" Content="进程退出（退出码 0）" GroupName="done"
                                     Style="{StaticResource Seg}" Checked="DoneMode_Checked" Tag="exit"/>
                        <RadioButton x:Name="RbDuration" Content="到达时长" GroupName="done"
                                     Style="{StaticResource Seg}" Checked="DoneMode_Checked" Tag="duration"/>
                    </StackPanel>
                    <Grid x:Name="DurationRow" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行满" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TbDuration" Grid.Column="1" Style="{StaticResource Field}" Margin="8,0,0,0"
                                 Text="60"/>
                        <TextBlock Grid.Column="2" Text="分钟视为完成" FontSize="11.5" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <TextBlock Text="进程退出：等程序自己结束；到达时长：跑满 N 分钟后自动收尾（会结束进程）。"
                               Style="{StaticResource Hint}"/>

                    <TextBlock Text="最大运行时长（分钟）" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TbMax" Style="{StaticResource Field}" Width="110" HorizontalAlignment="Left" Text="120"/>
                    <TextBlock Text="超过这个时间仍未完成，按超时处理；建议留足余量。" Style="{StaticResource Hint}"/>

                    <TextBlock Text="关联游戏进程（可选）" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TbGames" Style="{StaticResource Field}"/>
                    <TextBlock Text="多个用分号隔开，例如 YuanShen;GenshinImpact；用于开工前检查冲突。" Style="{StaticResource Hint}"/>

                    <TextBlock Text="图标" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="IconFallback" Text="?" FontSize="16" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Image x:Name="IconPreview" Stretch="Uniform" Margin="5" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock x:Name="IconHint" Text="选择程序后自动提取" FontSize="10.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <Button Content="重新提取" Style="{StaticResource CloseBtn}" Height="24"
                                    HorizontalAlignment="Left" Padding="0" Click="BtnIconRefresh_Click"
                                    Foreground="{DynamicResource BrandBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="TbError" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap"
                               Margin="0,10,0,0" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="18,8,18,16">
                <Button x:Name="BtnDelete" Content="删除这个工具" Style="{StaticResource Ghost}"
                        HorizontalAlignment="Left" Visibility="Collapsed" Click="BtnDelete_Click"
                        Foreground="{DynamicResource DangerBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="BtnClose_Click"/>
                    <Button Content="保存" Style="{StaticResource Primary}" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
