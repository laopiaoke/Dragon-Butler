<Window x:Class="DragonButler.MiniBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一条龙管家 · 浮条" Width="180" Height="44"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- v1.8 / F11：主界面缩到 180×44 的一小块。
         风格硬约束（见 docs/路线图.md 第九节）：
         只允许 CardBg / Border / TextPrimary / Brand 四个色键，
         圆角 14 与主界面卡片一致。
         v1.12：字号 12.5→13、11→11.5、次行透明度 0.6→0.75——
         180×44 里两行原先把「右键或点这里」糊成一片，实测看着像渲染坏了。 -->
    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="10,0"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TbTitle" Text="一条龙管家" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TbDetail" Text="空闲" FontSize="11.5" Margin="0,1,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.75"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 进度条：只有 2px 高的一条线，不给它单独的配色 -->
            <Border x:Name="BarHost" Grid.Column="0" Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom" Height="2" Margin="0,0,0,1"
                    Background="{DynamicResource BorderBrush}" CornerRadius="1"
                    Visibility="Collapsed">
                <Border x:Name="BarFill" HorizontalAlignment="Left" Width="0"
                        Background="{DynamicResource BrandBrush}" CornerRadius="1"/>
            </Border>

            <!-- 关闭：极小的一块，只在不跑时可见 -->
            <Button x:Name="BtnClose" Grid.Column="1" Content="✕" Width="18" Height="18"
                    VerticalAlignment="Center" Margin="8,0,0,0"
                    FontSize="11" Cursor="Hand" Focusable="False"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Background="Transparent" BorderThickness="0"
                    Click="BtnClose_Click"/>
        </Grid>
    </Border>
</Window>
