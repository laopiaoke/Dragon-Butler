<Window x:Class="DragonButler.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="第一次使用" Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="WizPrimary" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WizGhost" TargetType="Button" BasedOn="{StaticResource WizPrimary}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- v1.16：向导是每个新用户看到的第一个界面，之前这里的输入框与勾选框
             都是 WPF 默认的浅色控件——路径框白底黑字，在深色窗口里像贴了张纸。
             主窗那套 InputBox / 勾选框是窗口级资源，这里拿不到，必须自己写一份。 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v1.22：引导页的工具清单太长，16 个勾选框一列排下来像张表格，
             而且小方块勾上去很难确认自己点中了哪个。改成胶囊开关：
             整行都能点，开着的轨道是品牌色，扫一眼就知道选了什么。 -->
        <Style x:Key="WizPill" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="38" Height="21" CornerRadius="11"
                                Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border x:Name="Knob" Width="15" Height="15" CornerRadius="8"
                                    Background="{DynamicResource TextTertiaryBrush}"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource BrandOnBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v1.22：清单变长之后出现了滚动条，而 WPF 默认滚动条是系统浅色，
             在深色窗口里像贴了两条白胶带。自己画一条细的。 -->
        <Style x:Key="WizScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" CornerRadius="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" CornerRadius="4"
                                                        Background="{DynamicResource BorderStrongBrush}" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WizCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 3.5 8 L 6.6 11 L 12.4 5"
                                      Stroke="{DynamicResource BrandOnBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="14" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.38" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="第一次使用，三步就好" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TbStep" Text="第 1 步 / 共 3 步" FontSize="11" Margin="0,5,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <!-- 步骤 1：选择工具 -->
            <StackPanel x:Name="Step1" Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="打开你在用的那几个（可多选，之后也能改）" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <!-- 列表是滚动区：以后再加工具不会把窗口越撑越高 -->
                <ScrollViewer MaxHeight="312" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                              Padding="0,0,6,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource WizScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="ToolPickHost"/>
                </ScrollViewer>
                <TextBlock x:Name="TbPickSummary" FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <!-- 步骤 2：找路径 -->
            <StackPanel x:Name="Step2" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock Text="点「自动寻找」定位程序；找不到再手动浏览。" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel x:Name="FindHost" Margin="0,10,0,0"/>
                <TextBlock x:Name="TbFindSummary" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <!-- 步骤 3：完成 -->
            <StackPanel x:Name="Step3" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock Text="现在就绪了。" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="关掉这个窗口后，点队列卡上的「一键开跑」就能试一次；先跑一个工具也可以。"/>
                <TextBlock x:Name="TbDoneSummary" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Button x:Name="BtnSkip" Content="跳过" HorizontalAlignment="Left"
                        Style="{StaticResource WizGhost}" Click="BtnSkip_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="上一步" Style="{StaticResource WizGhost}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="BtnBack_Click"/>
                    <Button x:Name="BtnNext" Content="下一步" Style="{StaticResource WizPrimary}" Click="BtnNext_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
