<Window x:Class="DragonButler.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="第一次使用" Width="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="WizPrimary" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WizGhost" TargetType="Button" BasedOn="{StaticResource WizPrimary}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WizCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="14" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.38" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="第一次使用，三步就好" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TbStep" Text="第 1 步 / 共 3 步" FontSize="11" Margin="0,5,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <!-- 步骤 1：选择工具 -->
            <StackPanel x:Name="Step1" Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="勾选你正在用的工具（可多选，之后也能改）" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <CheckBox x:Name="CbBgi" Style="{StaticResource WizCheck}" Content="BetterGI（原神一条龙）" IsChecked="True"/>
                <CheckBox x:Name="CbMarch" Style="{StaticResource WizCheck}" Content="三月七助手（星穹铁道）"/>
                <CheckBox x:Name="CbOkww" Style="{StaticResource WizCheck}" Content="ok-ww（鸣潮）"/>
            </StackPanel>

            <!-- 步骤 2：找路径 -->
            <StackPanel x:Name="Step2" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock Text="点「自动寻找」定位程序；找不到再手动浏览。" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel x:Name="FindHost" Margin="0,10,0,0"/>
                <TextBlock x:Name="TbFindSummary" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <!-- 步骤 3：完成 -->
            <StackPanel x:Name="Step3" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock Text="现在就绪了。" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="关掉这个窗口后，点队列卡上的「一键开跑」就能试一次；先跑一个工具也可以。"/>
                <TextBlock x:Name="TbDoneSummary" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Button x:Name="BtnSkip" Content="跳过" HorizontalAlignment="Left"
                        Style="{StaticResource WizGhost}" Click="BtnSkip_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="上一步" Style="{StaticResource WizGhost}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="BtnBack_Click"/>
                    <Button x:Name="BtnNext" Content="下一步" Style="{StaticResource WizPrimary}" Click="BtnNext_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
