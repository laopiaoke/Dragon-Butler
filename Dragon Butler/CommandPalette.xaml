<Window x:Class="DragonButler.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命令面板" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- v1.8 / F15：Ctrl+K 出来的命令面板。
         配色只用现有语义令牌（CardBg / Border / TextPrimary / Brand / Hover），
         圆角 14 与主界面卡片同一标尺——它要像主界面的一部分，而不是另一个软件。 -->
    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="14" Padding="0"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel>

            <!-- 输入行 -->
            <Grid Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⌘" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource BrandBrush}"/>
                <TextBox x:Name="TbQuery" Grid.Column="1" FontSize="14"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Background="Transparent" BorderThickness="0"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         TextChanged="TbQuery_TextChanged"
                         PreviewKeyDown="TbQuery_PreviewKeyDown"/>
            </Grid>

            <Border Height="1" Background="{DynamicResource BorderBrush}"/>

            <!-- 结果列表 -->
            <ListBox x:Name="LbResults" MaxHeight="330" Margin="6,6,6,6"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="LbResults_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Group}" FontSize="11.5" Opacity="0.7"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- v1.12：选中态原来是 BrandSoft 一片深绿，
                                         和右列「运行/导航」的灰字挤在一起不好认。
                                         现在改成左侧竖条 + 浅底：竖条给眼睛一个硬边界，
                                         底色只做提示，不抢文字。 -->
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Border x:Name="Bar" Width="2" HorizontalAlignment="Left"
                                                    CornerRadius="1" Margin="0,-2,0,-2"
                                                    Background="Transparent"/>
                                            <ContentPresenter Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource BrandSoftBrush}"/>
                                            <Setter TargetName="Bar" Property="Background"
                                                    Value="{DynamicResource BrandBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Border Height="1" Background="{DynamicResource BorderBrush}"/>
            <TextBlock x:Name="TbHint" Margin="16,8,16,10" FontSize="11.5" Opacity="0.7"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="↑↓ 选择 · Enter 执行 · Esc 关闭"/>
        </StackPanel>
    </Border>
</Window>
