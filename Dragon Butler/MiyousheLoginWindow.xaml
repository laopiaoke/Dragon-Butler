<Window x:Class="DragonButler.MiyousheLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="米游社账号" Width="560" Height="740"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <!-- v1.31：米游社登录。
         这个窗口存在的唯一理由：让用户不用去翻 F12 抄一长串 cookie。
         主路径是「点一下，弹出的浏览器里登录，回来就好了」；手填留作后路
         （公司电脑禁 Edge、或者已经在别处登录过只差粘一下）。 -->
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{DynamicResource BrandBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Background="{DynamicResource WindowBgBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="米游社账号" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TbState" FontSize="11" Margin="10,2,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="还没登录"/>
                </StackPanel>
                <Button Content="✕" Width="38" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0"
                        Style="{StaticResource CloseBtn}" Click="BtnClose_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 说明 -->
                <TextBlock Grid.Row="0" FontSize="11.5" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="签到要的是你登录之后的凭证。手机上的米游社扫一下就行——不用输密码，也不用去翻 F12 抄一长串东西。&#x0a;扫完这个窗口自己关掉，之后每次跑完一条龙顺手帮你签。"/>

                <!-- 主路径 -->
                <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource CardBg2Brush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnQr" Content="扫码登录" Style="{StaticResource Primary}"
                                    VerticalAlignment="Center" Click="BtnQr_Click"
                                    ToolTip="用手机上的米游社扫一下，不用输密码，也不用去找 cookie"/>
                            <Button x:Name="BtnBrowser" Content="用浏览器登录" Style="{StaticResource Ghost}"
                                    Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnBrowser_Click"
                                    ToolTip="手机不在手边时用这个：开一个小窗口，在里面正常登录">
                            </Button>
                            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource Ghost}"
                                    Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                    Click="BtnCancel_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TbBrowserHint" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="手机上的米游社 → 右上角扫一扫。扫完这边自己继续，不用手抄任何东西。"/>

                        <!-- 二维码（点「扫码登录」之后才出现）。
                             居中而不是靠左：它是这个窗口此时唯一要人看的东西，
                             摆在左边、右边空一大片，看着像是还没画完。 -->
                        <StackPanel x:Name="QrPanel" Visibility="Collapsed" Margin="0,14,0,0"
                                    HorizontalAlignment="Center">
                            <Border HorizontalAlignment="Center" Padding="12" CornerRadius="12"
                                    Background="White">
                                <Image x:Name="QrImage" Width="196" Height="196"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <TextBlock x:Name="TbQrHint" FontSize="10.5" TextWrapping="Wrap" Margin="0,9,0,0"
                                       MaxWidth="320" TextAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="二维码 3 分钟内有效。"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 手填 -->
                <TextBlock Grid.Row="2" Margin="0,16,0,6" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="或者，把浏览器里的 cookie 粘进来（高级）"/>

                <TextBox Grid.Row="3" x:Name="TbCookie" Style="{StaticResource Box}" Height="74"
                         ToolTip="登录后按 F12 → Network → 任意一条 miyoushe 请求 → 复制 Request Headers 里的 Cookie 整行"/>

                <ScrollViewer Grid.Row="4" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="粘完点下面的「认一下」。缺 stoken 也能签到，只是过期后要再登一次。"/>
                        <TextBox x:Name="TbStoken" Style="{StaticResource Box}" Height="52"
                                 ToolTip="可留空。填了就能在你不在的时候自动续期"/>
                        <TextBlock x:Name="TbRecognize" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底栏 -->
            <Grid Grid.Row="2" Margin="18,10,18,14">
                <TextBlock x:Name="TbFoot" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"
                           MaxWidth="300" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="凭证只存在你自己的设置文件里，不上传任何地方。"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRecognize" Content="认一下" Style="{StaticResource Ghost}"
                            Margin="0,0,6,0" Click="BtnRecognize_Click"/>
                    <Button x:Name="BtnSave" Content="保存" Style="{StaticResource Primary}"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
