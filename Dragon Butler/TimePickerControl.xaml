<UserControl x:Class="DragonButler.TimePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <UserControl.Resources>
        <!-- 文字按钮（无圆角边框胶囊，风格与主界面卡片一致） -->
        <Style x:Key="TextBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 视图切换图标按钮（时钟 / 滚筒 / 键盘） -->
        <Style x:Key="ModeIcon" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="32" Height="26" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 大号时间数字按钮（无边框，点击切换编辑哪一段） -->
        <Style x:Key="TimePart" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- 键盘输入框：大字号（34px）居中，等宽数字，聚焦时描边转品牌色 -->
        <Style x:Key="CompactInput" TargetType="TextBox">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.28"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第一行：视图切换（时钟/滚筒/键盘）+ 大号时间 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Center" Background="{DynamicResource ControlBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="2"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <!-- 时钟（圆盘选择，默认） -->
                    <RadioButton x:Name="ModeClock" Style="{StaticResource ModeIcon}" Tag="Clock"
                                 Checked="ModeIcon_Checked" ToolTip="圆盘选择（推荐）">
                        <Path Data="M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M12 8v4l3 2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </RadioButton>
                    <!-- 滚筒 -->
                    <RadioButton x:Name="ModeDrum" Style="{StaticResource ModeIcon}" Tag="Drum"
                                 Checked="ModeIcon_Checked" ToolTip="滚筒滑动（可无限滚动）">
                        <Path Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M3 9h18 M3 15h18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </RadioButton>
                    <!-- 键盘 -->
                    <RadioButton x:Name="ModeKeyboard" Style="{StaticResource ModeIcon}" Tag="Keyboard"
                                 Checked="ModeIcon_Checked" ToolTip="键盘输入">
                        <Path Data="M3 6h18v12H3z M6 10h.01 M9 10h.01 M12 10h.01 M15 10h.01 M18 10h.01 M7 14h10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.75" StrokeStartLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </RadioButton>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnHourPart" Style="{StaticResource TimePart}" Click="HourPart_Click" ToolTip="修改小时">
                    <TextBlock x:Name="TbHourBig" Text="08" FontSize="30" FontWeight="SemiBold"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <TextBlock Text=":" FontSize="26" Margin="3,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Button x:Name="BtnMinutePart" Style="{StaticResource TimePart}" Click="MinutePart_Click" ToolTip="修改分钟">
                    <TextBlock x:Name="TbMinuteBig" Text="00" FontSize="30" FontWeight="SemiBold"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 第二行：三种选择视图（同一位置切换显示，固定 300 高避免切视图时窗口跳动） -->
        <Grid Grid.Row="1" Margin="0,10,0,0" MinHeight="300">
            <!-- 时钟圆盘（默认）：盘面/数字/指针/选中圆由代码生成 -->
            <Canvas x:Name="ClockView" Width="300" Height="300" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="Transparent" Cursor="Hand"/>

            <!-- 滚筒视图：时列 / 冒号 / 分列，由代码构建 -->
            <Grid x:Name="DrumView" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" x:Name="HourSlot"/>
                <TextBlock Grid.Column="2" Text=":" FontSize="26"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Grid Grid.Column="4" x:Name="MinuteSlot"/>
            </Grid>

            <!-- 键盘视图：大号输入框 + 单位标签 -->
            <Grid x:Name="KeyboardView" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" x:Name="TbHourInput" Style="{StaticResource CompactInput}"
                         TextChanged="HourInput_TextChanged" LostFocus="CompactInput_LostFocus"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text=":" FontSize="32" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,14,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="2" x:Name="TbMinuteInput" Style="{StaticResource CompactInput}"
                         TextChanged="MinuteInput_TextChanged" LostFocus="CompactInput_LostFocus"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="小时" FontSize="11.5" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="分钟" FontSize="11.5" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
            </Grid>
        </Grid>

        <!-- 第三行：操作提示 + 取消 / 确定 -->
        <Grid Grid.Row="2" Margin="6,8,6,0">
            <TextBlock x:Name="TbHint" Text="在圆盘上滑动即可选小时" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource TextBtn}" Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm" Content="确定" Style="{StaticResource TextBtn}" Click="BtnConfirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
