<!--
    v1.46.2 / 任务书 #18：托盘右键菜单的 WPF 样式（复刻主界面底部导航栏的视觉语言）。

    为什么单独一个文件：托盘菜单是弹出层，挂在独立的可视树上，只有应用级资源一定落得到它身上；
    但直接写进 App.xaml 的隐式样式会跟其它窗口的右键菜单混在一起，改一个动一片。放这里、只给托盘用。

    约束（任务书「资源策略」四条）：
    1. 导航栏已有的资源键 → 直接 DynamicResource 引用，引用是只读操作；
    2. 导航栏是硬编码字面值的 → 在本文件用 TrayMenu.* 前缀新建键，字面值照抄；
    3. 不改任何既有键的值，也不把它们搬到这里重定义；
    4. 本文件只允许出现 TrayMenu.* 前缀的键。

    配色一律 DynamicResource：主界面切主题时 Theme.Apply 会把新刷子写进应用资源，
    菜单下次弹出就是新颜色，不需要重启，也不需要在这里另存一套深浅对照。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 只有导航栏硬编码、没有资源键的那几样，抄字面值 ============ -->

    <!--
        按下态：导航栏没有「按下」这一档（导航栏那块滑动的底是 NavPill，跟着选中项走，
        不是按压反馈）。但菜单项按下去必须有一点回应，否则像没点上。
        这里用一层 20% 黑压色——深浅主题都成立，不依赖任何色键。
        这是本文件唯一一处不经导航栏的视觉决定，写在这里备案。
    -->
    <SolidColorBrush x:Key="TrayMenu.PressedOverlay" Color="#33000000" />

    <!-- 外壳投影：源=MainWindow.xaml.cs:296-297 与 NavShellShadow（BlurRadius 22 / ShadowDepth 6 / 270 / 0.5 / #05070A） -->
    <DropShadowEffect x:Key="TrayMenu.ShellShadow" BlurRadius="22" ShadowDepth="6" Direction="270"
                      Opacity="0.5" Color="#05070A" />

    <!-- ============ 外壳：圆角卡片，与导航栏同一套「浮起来的玻璃」观感 ============ -->
    <!--
        几何照抄导航栏、按行高换算（源=MainWindow.xaml:3089 NavShell 58 高/圆角 27 = 0.47；
        :2622 NavPill 46 高/圆角 19 = 0.41）。菜单行比导航项矮，直接套 19 会像胶囊，
        所以按同一比例换算成外壳 16、行 11。
    -->
    <Style x:Key="TrayMenu.ContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource CardBg2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <!-- 源=MainWindow.xaml:10 的窗口字体，菜单与主界面同族 -->
        <Setter Property="FontFamily" Value="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <!-- 对齐主界面现状（MainWindow.xaml:6），小字号不做 Display 模式会糊 -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="6"
                            Effect="{StaticResource TrayMenu.ShellShadow}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 菜单项：模板里根本不画图标列 ============ -->
    <!--
        左侧那条空白是 WinForms 那一套菜单控件的 ImageMargin（默认给一列图标位、而项目从没放过图标）。
        换成 WPF 模板之后不是「把图标列调窄」，而是**模板里没有这一列**——
        布局就是「文字，从左边缘内缩一个 Padding」，左边什么也不留。
    -->
    <Style x:Key="TrayMenu.ItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="11,7,13,7" />
        <Setter Property="MinWidth" Value="192" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border x:Name="Pressed" Background="{StaticResource TrayMenu.PressedOverlay}"
                                CornerRadius="11" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：底色用全应用统一的 HoverBrush，文字从次级提到主级（与导航栏悬停同方向） -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <!-- 按下：再压一档，与导航栏「按下去有回应」的手感一致 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Pressed" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <!-- 禁用：三级文字色，光标恢复箭头（导航栏禁用态同款处理） -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 分隔线：一根 1px，缩进对齐文字起点 ============ -->
    <Style x:Key="TrayMenu.SeparatorStyle" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,5,6,5"
                            Background="{DynamicResource BorderBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
