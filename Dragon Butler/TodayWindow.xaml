<Window x:Class="DragonButler.TodayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日运行" Width="720" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <!-- v1.13：把今天这一盘「回放」一遍。
         数据早就在 group_archive.json 与 run_journal.json 里，只是从来没人把它们摆出来看。
         ABGI 的「归档查询」是网页里翻一页；这里做成一张随手的收据：
         哪几组跑了、各花了多久、比往常快还是慢、哪个工具没跑成、为什么。 -->
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="今日运行" FontSize="13.5" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnReport" Content="复制文字版" Style="{StaticResource Ghost}" Height="28"
                            FontSize="11.5" Padding="10,0" Click="BtnReport_Click"
                            ToolTip="把今天这一盘整理成几行文字，直接粘贴到群里"/>
                    <Button Content="✕" Width="38" Height="28" Margin="6,0,0,0"
                            Style="{StaticResource CloseBtn}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TbHeadline" Grid.Row="1" Margin="18,0,18,10" FontSize="12"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- 配置组：今天 BGI 内部实际跑过的组 -->
            <StackPanel Grid.Row="2" Margin="18,0,18,0">
                <TextBlock x:Name="TbGroupHeader" Text="配置组" FontSize="11" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <ScrollViewer x:Name="GroupScroll" VerticalScrollBarVisibility="Auto" MaxHeight="210">
                    <StackPanel x:Name="GroupHost"/>
                </ScrollViewer>
            </StackPanel>

            <!-- 工具：队列台账（哪些跑成了、哪些没成、为什么） -->
            <StackPanel Grid.Row="3" Margin="18,14,18,0">
                <TextBlock x:Name="TbToolHeader" Text="队列台账" FontSize="11" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <ScrollViewer x:Name="ToolScroll" VerticalScrollBarVisibility="Auto" MaxHeight="150">
                    <StackPanel x:Name="ToolHost"/>
                </ScrollViewer>
            </StackPanel>

            <TextBlock x:Name="TbFoot" Grid.Row="4" Margin="18,12,18,0" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>

            <Grid Grid.Row="5" Margin="18,14,18,16">
                <TextBlock x:Name="TbSummary" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Content="关闭" HorizontalAlignment="Right" Style="{StaticResource Ghost}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
