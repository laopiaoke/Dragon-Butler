<Window x:Class="DragonButler.GroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置组切片" Width="760" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14"
            BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
        <StackPanel>
            <!-- 标题栏 -->
            <Grid Height="46" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="配置组切片" FontSize="13.5" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button x:Name="BtnClose" Content="✕" Style="{StaticResource CloseBtn}"
                        HorizontalAlignment="Right" Margin="0,0,10,0" Click="BtnClose_Click"/>
            </Grid>

            <TextBlock Margin="18,0,18,12" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="左边选一项，右边勾「它要跑哪几个配置组」。什么都不勾＝沿用上面的全局勾选，和以前完全一样。"/>

            <Grid Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="6">
                    <ListBox x:Name="LbEntries" Background="Transparent" BorderThickness="0"
                             MaxHeight="300" SelectionChanged="LbEntries_SelectionChanged"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>

                <ScrollViewer Grid.Column="2" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TbPickHint" FontSize="10.5" Margin="0,2,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Text="先用一趟一个组，这里会列出识别到的配置组。"/>
                        <WrapPanel x:Name="GroupHost"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <TextBlock x:Name="TbSummary" Margin="18,12,18,0" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>

            <Grid Margin="18,14,18,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="这项改用全局" Style="{StaticResource Ghost}" Click="BtnClearOne_Click"/>
                    <Button Content="全部改用全局" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="BtnClearAll_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource Ghost}" Click="BtnCancel_Click"/>
                    <Button Content="保存" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
