<Window x:Class="DragonButler.TidyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="跑完收拾一下" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- v1.20：主窗的 SwitchStyle 是窗口级资源，这里拿不到，自己写一份。 -->
        <Style x:Key="TidySwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="11">
                            <Ellipse x:Name="Knob" Width="15" Height="15" Fill="{DynamicResource TextTertiaryBrush}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource BrandOnBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="跑完收拾一下" FontSize="13.5" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="✕" Style="{StaticResource CloseBtn}" HorizontalAlignment="Right"
                        Margin="0,0,10,0" Click="BtnClose_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" Margin="18,0,18,12" FontSize="11.5" LineHeight="18"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="跑完之后留下的痕迹，替你自己清掉。默认全关——关掉别人正在用的程序是不可逆的，要你亲口打开才做。"/>

            <StackPanel Grid.Row="2" Margin="18,0,18,0">
                <Grid Margin="0,4,0,10">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                        <TextBlock Text="跑完收拾一下" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="总开关。关着的时候下面三项都不生效。" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                    <ToggleButton x:Name="TgTidy" Style="{StaticResource TidySwitch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="TgTidy_Click"/>
                </Grid>

                <!-- 后三项缩进一格：它们是总开关下面的子项，平铺会让人以为四个开关平级。 -->
                <Grid Margin="14,0,0,10">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                        <TextBlock Text="关掉 BetterGI" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="让原工具退出，不留一个开着的主界面在那儿。" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                    <ToggleButton x:Name="TgCloseTool" Style="{StaticResource TidySwitch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="TgCloseTool_Click"/>
                </Grid>

                <Grid Margin="14,0,0,10">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                        <TextBlock Text="把窗口放回原处" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="跑之前记住游戏和原工具窗口在哪，跑完挪回去。" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                    <ToggleButton x:Name="TgRestore" Style="{StaticResource TidySwitch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="TgRestore_Click"/>
                </Grid>

                <Grid Margin="14,0,0,4">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                        <TextBlock Text="关掉游戏" FontSize="12.5" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock x:Name="TbGameHint" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="这一步不可逆，所以单独一个开关。上一轮有失败时不会关——那时候你多半想自己看一眼现场。"/>
                    </StackPanel>
                    <ToggleButton x:Name="TgCloseGame" Style="{StaticResource TidySwitch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="TgCloseGame_Click"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="4" Margin="18,14,18,16">
                <TextBlock x:Name="TbFoot" FontSize="10.5" VerticalAlignment="Center"
                           MaxWidth="360" TextWrapping="Wrap" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="知道了" Style="{StaticResource Ghost}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
