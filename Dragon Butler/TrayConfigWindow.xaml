<Window x:Class="DragonButler.TrayConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="托管配置" Width="720" Height="560"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <!--
        v1.30：托管配置从「主窗里一张卡 + 一堆折叠行」搬成一个独立窗口。

        原来点「工具设置」要在启动页里往下滚、展开折叠行、再在长列表里找那个工具，
        三步都做完才看得到一个 exe 路径。现在这条路改成：主窗上一个小齿轮 → 这个窗口，
        窗口里就是一个桌面（3 列 2 行），图标即入口：
          左键单击 → 打开这个工具的启动设置（同一个 ToolLaunchWindow）
          左键双击 → 直接把它的主程序拉起来跑一次
          右键      → 菜单：今晚跑不跑 / 改配置 / 移除
          拖拽      → 换顺序（插入不是交换，别的一格让位）
          悬停      → 底下那行说明「左键 双击 右键 各做什么」

        为什么是 3 列：「一屏放得下六个」是这张桌子的容量，不是装饰。
    -->
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="16" BorderThickness="1"
            BorderBrush="{DynamicResource BorderStrongBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：可拖动 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Path Data="M4 5h11M4 10h11M4 15h7" Stroke="{DynamicResource BrandBrush}" StrokeThickness="1.9"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"/>
                    <TextBlock Text="托管配置" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbCount" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnAdd" Content="＋ 添加" Style="{StaticResource Ghost}" Height="26"
                            Padding="9,0" Click="BtnAdd_Click"
                            ToolTip="内置清单里没有的游戏工具也行——给它一个 exe 和参数"/>
                    <Button x:Name="BtnClose" Content="✕" Style="{StaticResource CloseBtn}" Margin="8,0,0,0"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- 提示行：悬停某格时换成那一格的说明 -->
            <TextBlock x:Name="TbHint" Grid.Row="1" Margin="16,2,16,0" FontSize="10.5" TextWrapping="Wrap"
                       Text="左键单击改设置 · 双击直接启动 · 右键改「今晚跑不跑」/移除 · 按住拖到别处换顺序"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>

            <!-- 桌面：3 列 × 2 行，一页 6 格。
                 这里原来套了一层 ScrollViewer，但它没有东西可滚——一页固定 6 格，
                 翻页是横滑不是滚动；而 ScrollViewer 的内容高度由子元素撑，星号行没有
                 上限就塌成内容那么高，结果两行格子挤在上半截、下面空出一大片。
                 改成纯 Grid：桌面吃满剩下的高度，下面一行留给页码点。 -->
            <Grid Grid.Row="2" Margin="14,10,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TileClip" Grid.Row="0" ClipToBounds="True" Background="Transparent"
                        SizeChanged="TileClip_SizeChanged"
                        IsManipulationEnabled="True"
                        ManipulationStarting="TileClip_ManipulationStarting"
                        ManipulationDelta="TileClip_ManipulationDelta"
                        ManipulationCompleted="TileClip_ManipulationCompleted">
                    <Grid x:Name="TileHost"/>
                </Border>
                <!-- 拖动中的那一格搬到这里：在裁切外面，拖到边缘不会被切掉 -->
                <Canvas x:Name="DragLayer" Grid.Row="0" IsHitTestVisible="False"/>

                <StackPanel x:Name="PageDotsHost" Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"
                            HorizontalAlignment="Center"/>
            </Grid>

            <!-- 底栏 -->
            <Grid Grid.Row="3" Margin="16,8,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TbFoot" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="TbOverflow" FontSize="10.5" Margin="0,3,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnQueue" Content="今晚队列…" Style="{StaticResource Ghost}"
                            Click="BtnQueue_Click"
                            ToolTip="按日计划、依赖、跑完做什么——那些是队列的事，不在这张桌子上"/>
                    <Button x:Name="BtnDone" Content="好了" Style="{StaticResource Primary}" Margin="8,0,0,0"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
