<Window x:Class="DragonButler.PresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置组合" Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 窗口级 TextBox 样式：主窗那套是窗口级资源，这里拿不到 -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource InsetBrush}" CornerRadius="7"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14"
            BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
        <StackPanel>
            <Grid Height="46" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="配置组合" FontSize="13.5" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="✕" Style="{StaticResource CloseBtn}"
                        HorizontalAlignment="Right" Margin="0,0,10,0" Click="BtnClose_Click"/>
            </Grid>

            <TextBlock Margin="18,0,18,10" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="一套组合就是「用哪个一条龙配置 + 跑哪几个配置组」。开跑时挑一套，别的都不动——不写任何文件，只是把参数换成这套。"/>

            <!-- 现在这套 -->
            <Border Margin="18,0,18,0" Background="{DynamicResource InsetBrush}" CornerRadius="9" Padding="12,9">
                <StackPanel>
                    <TextBlock x:Name="TbCurrent" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="18,10,18,0">
                <StackPanel x:Name="PresetHost"/>
            </ScrollViewer>

            <TextBlock x:Name="TbEmpty" Margin="18,10,18,0" FontSize="11" TextWrapping="Wrap"
                       Visibility="Collapsed" Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="还没有组合。下面填个名字，把它存成第一套。"/>

            <!-- 新建 -->
            <Grid Margin="18,12,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbNewName" Grid.Column="0" Style="{StaticResource Field}" MaxLength="24"/>
                <Button Grid.Column="1" Content="存为新的组合" Style="{StaticResource Primary}"
                        Margin="8,0,0,0" Click="BtnAdd_Click"/>
            </Grid>
            <TextBlock x:Name="TbNewHint" Margin="18,6,18,0" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="不填名字会自动编号。存的是「此刻的配置名和勾选」，之后你再改全局勾选，这套组合不跟着变。"/>

            <Grid Margin="18,14,18,18">
                <TextBlock x:Name="TbFoot" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,90,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Button Content="完成" Style="{StaticResource Ghost}" HorizontalAlignment="Right"
                        Click="BtnClose_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
