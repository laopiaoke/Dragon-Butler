<Window x:Class="DragonButler.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="挂机日历" Width="740" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <!-- v1.8 / F13：把「这半年到底跑了多少天」摊成一张方格墙。
         只读 GroupArchive 已有的记录，不新增任何数据采集——
         一份已经存在但没人看的数据，换个画法就成了最有说服力的东西。 -->
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="挂机日历" FontSize="13.5" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="✕" Width="38" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0"
                        Style="{StaticResource CloseBtn}" Click="BtnClose_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" Margin="18,0,18,12" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="过去一年的挂机足迹。每个方格是一天：绿色是全部跑成，黄色是有失败，红色是全没成，灰色是没跑。数据来自已有的队列记录，不额外抓任何东西。"/>

            <!-- 月份标签 + 方格墙 -->
            <Grid Grid.Row="2" Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TbMonthLabels" Grid.Column="0" FontSize="10" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Grid x:Name="GridHost" Grid.Column="1" HorizontalAlignment="Left"/>
            </Grid>

            <!-- 图例 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="18,14,18,0">
                <Ellipse x:Name="DotSuccess" Width="9" Height="9" VerticalAlignment="Center"/>
                <TextBlock Text="全部成功" FontSize="11" Margin="6,0,16,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Ellipse x:Name="DotWarning" Width="9" Height="9" VerticalAlignment="Center"/>
                <TextBlock Text="有失败" FontSize="11" Margin="6,0,16,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Ellipse x:Name="DotDanger" Width="9" Height="9" VerticalAlignment="Center"/>
                <TextBlock Text="全没成" FontSize="11" Margin="6,0,16,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Ellipse x:Name="DotIdle" Width="9" Height="9" VerticalAlignment="Center"/>
                <TextBlock Text="没跑" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="4" Margin="18,12,18,16">
                <TextBlock x:Name="TbSummary" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Button Content="关闭" HorizontalAlignment="Right" Style="{StaticResource Ghost}"
                        Click="BtnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
