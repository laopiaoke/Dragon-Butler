                                            <ComboBoxItem Content="仅通知" Tag="Notify"/>
                                            <ComboBoxItem Content="再跑一轮" Tag="RunAgain"/>
                                            <ComboBoxItem Content="打开程序" Tag="OpenApp"/>
                                            <ComboBoxItem Content="自动睡眠" Tag="Sleep"/>
                                            <ComboBoxItem Content="自动关机" Tag="Shutdown"/>
                                        </ComboBox>
                                    </Grid>
                                    <!-- v1.15 / L5：只有选了「打开程序」才要填路径。
                                         平时不显示——一个平时不用的输入框，占了版面还让人以为必须填。 -->
                                    <Grid x:Name="AfterRunAppRow" Margin="0,0,0,9" Visibility="Collapsed">
                                        <TextBlock x:Name="TbAfterRunApp" Text="还没选程序" FontSize="11.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,74,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <Button Content="选择…" Style="{StaticResource MiniAction}"
