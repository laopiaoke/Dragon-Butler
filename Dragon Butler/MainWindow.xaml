                                            <TextBlock x:Name="TbQueueTemplateWatermark" Text="留空用默认正文"
                                                       FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="TbQueueTemplateHint" FontSize="10" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- 可选：BGI Webhook（不填也能自动识别配置组） -->
                                    <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="9"
                                            Background="{DynamicResource CardBg2Brush}" BorderBrush="{DynamicResource BorderBrush}"
