                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="端口（465/587）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailPort" Tag="NotifyEmailPort" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock Text="SMTP 用户名" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailUser" Tag="NotifyEmailUser" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock Text="密码 / 授权码" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailPass" Tag="NotifyEmailPass" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock Text="发件人（留空=用户名）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailFrom" Tag="NotifyEmailFrom" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock Text="收件人（多个用分号）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailTo" Tag="NotifyEmailTo" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- xxtui -->
                                <StackPanel x:Name="NpXxtui" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="xxtui API 地址或 API Key" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyXxtui" Tag="NotifyXxtuiUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="只填 Key 会自动补全为 https://www.xxtui.com/xxtui/Key"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 自定义 Webhook -->
                                <StackPanel x:Name="NpWebhook" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="自定义 Webhook 地址" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyWebhook" Tag="NotifyWebhookUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="POST JSON：source / level / title / message / timestamp"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- WebSocket -->
                                <StackPanel x:Name="NpWebSocket" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="WebSocket 地址（ws:// 或 wss://）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyWebSocket" Tag="NotifyWebSocketUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="连接成功后发送一条 JSON 即关闭（与 BetterGI 的 WebSocket 行为一致）"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 推送频率 -->
                                <Grid Margin="0,12,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="只推送异常" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="开启后「一条龙启动/完成」不推送，只推异常与卡死"
                                                   FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="TgNotifyOnlyImportant" Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="TgNotifyOnlyImportant_Click"/>
                                </Grid>

                                <!-- 测试 -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnTestWebhook" Content="发送测试消息" Style="{StaticResource FlatButton}"
                                            Height="30" Padding="12,0" Click="BtnTestWebhook_Click"/>
                                    <TextBlock Grid.Column="1" x:Name="TbNotifyTestResult" FontSize="11" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>

                                <!-- v1.15 / L6：跑完那条通知，正文可以改一句话 -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="跑完通知的正文" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Grid Margin="0,5,0,0">
                                        <TextBox x:Name="TbQueueTemplate" Style="{StaticResource InputBox}"
                                                 LostFocus="TbQueueTemplate_LostFocus"
                                                 TextChanged="TbQueueTemplate_TextChanged"/>
                                        <!-- 空框里放一句灰字：不填也要让人知道这格能填什么 -->
                                        <TextBlock x:Name="TbQueueTemplateWatermark" Text="留空用默认正文"
                                                   FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                    <TextBlock x:Name="TbQueueTemplateHint" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 可选：BGI Webhook（不填也能自动识别配置组） -->
                                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="9"
                                        Background="{DynamicResource CardBg2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="进度识别（可选）" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TbBgiWebhookHint" FontSize="10.5" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                        <Button x:Name="BtnCopyWebhook" Content="复制地址" Style="{StaticResource FlatButton}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Height="26" Padding="10,0"
                                                Click="BtnCopyWebhook_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- v1.32/v1.33：悬浮标签栏。
                 v1.33 修了两处：
                 ① 它原来占自己一行（Grid.Row="2"），于是窗口为了它多长出一截，卡片区被顶短。
                    现在它坐在内容区里（Row 1）浮在最上层，卡片从它底下滚过去——这才是「悬浮」。
                 ② 点击没反应。原因是按下就 CaptureMouse()，鼠标被这块 Border 抢走，
                    底下的 RadioButton 收不到完整的按下/松开序列，Checked 永远不会触发。
                    现在只有真的拖出 4px 才捕获，纯点击一律让给按钮自己。 -->
            <Grid Grid.Row="1" Panel.ZIndex="20" Background="Transparent"
                  VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border x:Name="NavShell" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource CardBg2Brush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="25" Padding="5" Height="58"
                        Opacity="0.97"
                        PreviewMouseLeftButtonDown="NavShell_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="NavShell_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="NavShell_PreviewMouseLeftButtonUp">
                    <Grid>
                        <!-- 会滑的那块底。宽高跟单个标签项一致，靠 TranslateTransform 走位。 -->
                        <Border x:Name="NavPill" Width="84" Height="46" CornerRadius="19"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource BrandSoftBrush}" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavPillShift" X="0"/>
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel x:Name="NavItemsHost" Orientation="Horizontal">
                        <!-- 运行：一个环形箭头（「刚才跑了什么」） -->
                        <RadioButton x:Name="SegPageRun" Tag="0"
                                     Style="{StaticResource NavBtn}" Checked="SegPage_Checked"
                                     ToolTip="看刚才/今天跑了什么">
                            <StackPanel>
                                <Path Data="M13.5,3.2 A6.4,6.4 0 1 0 16,8" Width="18" Height="18"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="运行" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 启动：房子（「接下来几点跑」，每天回来的那一页） -->
                        <RadioButton x:Name="SegPageHome" Tag="1" IsChecked="True"
                                     Style="{StaticResource NavBtn}" Checked="SegPage_Checked"
                                     ToolTip="定时、托管配置、一键开跑">
                            <StackPanel>
                                <Path Data="M3,9.5 L10,3 L17,9.5 L17,16.5 L3,16.5 Z" Width="18" Height="18"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="启动" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 设置：两根滑杆（「把东西配好」） -->
                        <RadioButton x:Name="SegPageSettings" Tag="2"
                                     Style="{StaticResource NavBtn}" Checked="SegPage_Checked"
                                     ToolTip="工具、通知、系统和插件">
                            <StackPanel>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M2,5.5 L16,5.5 M2,12.5 L16,12.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Margin="9,3,0,0"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                             Margin="4,0,0,3"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                                <TextBlock Text="设置" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部状态条：守护盾牌 + 最近一条事件 -->
            <Border Grid.Row="2" x:Name="StatusBarBorder" Background="{DynamicResource InsetBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Background="Transparent"
                                MouseEnter="Shield_MouseEnter" MouseLeave="Shield_MouseLeave">
                        <Ellipse x:Name="ShieldDot" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource TextTertiaryBrush}"/>
                        <Path Data="M12 3l7 4v5c0 4-3 7-7 9-4-2-7-5-7-9V7z" Stroke="{DynamicResource TextTertiaryBrush}"
                              StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShieldText" Text="守护未开启" FontSize="10.5" Margin="5,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Border x:Name="ShieldTip" Visibility="Collapsed" Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="10,7" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ShieldTipText" FontSize="10.5" TextWrapping="Wrap" MaxWidth="520"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TbLog" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="12,0,10,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
