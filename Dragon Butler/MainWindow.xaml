                                                <TextBlock Grid.Column="2" Text="停止" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,8,0"/>
                                                <TextBox x:Name="TbHotkeyStop" Grid.Column="3" Text="Ctrl+Alt+S" FontSize="11.5"
                                                         Style="{StaticResource InputBox}" Height="28"
                                                         LostFocus="TbHotkeyStop_LostFocus"/>
