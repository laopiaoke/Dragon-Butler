                                                <ToggleButton x:Name="TgLanPanel" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgLanPanel_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TbLanPanelHint" Style="{StaticResource SetHint}"
                                                       Text="打开后同一 Wi-Fi 下的手机浏览器可以看进度和最近一条事件，但没有任何按钮——只能看，不能指挥。"/>
