                                    <!-- 测试 -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnTestWebhook" Content="发送测试消息" Style="{StaticResource FlatButton}"
                                                Height="30" Padding="12,0" Click="BtnTestWebhook_Click"/>
                                        <TextBlock Grid.Column="1" x:Name="TbNotifyTestResult" FontSize="11" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>

                                    <!-- v1.15 / L6：跑完那条通知，正文可以改一句话 -->
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="跑完通知的正文" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Grid Margin="0,5,0,0">
                                            <TextBox x:Name="TbQueueTemplate" Style="{StaticResource InputBox}"
                                                     LostFocus="TbQueueTemplate_LostFocus"
                                                     TextChanged="TbQueueTemplate_TextChanged"/>
