                                            Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <TextBlock x:Name="IconText_okww" Text="W" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="IconImage_okww" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Left" Text="ok-ww" FontSize="13.5" FontWeight="SemiBold"
                                               Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Left" x:Name="TbToolState_okww" Text="未配置" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DockPanel>
                            </Button>
                            <StackPanel x:Name="Body_okww" Margin="16,0,16,14" Visibility="Collapsed">
                                <TextBlock Text="程序位置（点「自动寻找」多数情况不用手填）" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TbPath_okww" Style="{StaticResource InputBox}" IsReadOnly="True" Height="32"/>
                                    <Button Grid.Column="1" Content="浏览" Style="{StaticResource MiniAction}" Margin="8,0,0,0"
                                            Click="ToolBrowse_Click" Tag="ok-ww"/>
                                    <Button Grid.Column="2" Content="自动寻找" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolAutoFind_Click" Tag="ok-ww"/>
                                    <Button Grid.Column="3" Content="测试启动" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolTest_Click" Tag="ok-ww"/>
                                    <Button Grid.Column="4" Content="换图标" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolIcon_Click" Tag="ok-ww" ToolTip="换成你喜欢的图标（.ico / .exe / .png）"/>
                                </Grid>
                                <TextBlock x:Name="TbFindHint_okww" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 自定义工具（v1.4）：运行时生成卡片 -->
                    <StackPanel x:Name="CustomToolsHost"/>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="自定义工具" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="任意 exe 都能接入：填路径、进程名和完成方式即可。" FontSize="10.5"
                                           Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <Button Content="＋ 添加" Style="{StaticResource MiniAction}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="BtnAddCustomTool_Click"/>
                        </Grid>
                    </Border>
                            </StackPanel>
                        </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== 右页：设置 =====
                         工具、通知、系统这些「配一次就不常动」的东西全在这页。
                         它们以前压在中页下面，得滚很久；现在右滑一步就到，
                         而中页从此只剩「今晚跑什么」这件事。 -->
                    <ScrollViewer x:Name="ScrollSettings" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform x:Name="ShiftSettings" X="980"/>
                        </ScrollViewer.RenderTransform>
                        <Grid x:Name="PageSettings" Margin="14,10,14,88">
                            <!-- v1.32：设置页从「五条等宽长条摞在一起」改成卡片墙。
                                 原来四块长得一模一样、上下等距，看着像一列抽屉，分不清是四件事；
                                 现在短的两块（插件、通知）并排放，长的两块（高级设置、系统）各占整行——
                                 长度不一样，眼睛才认得出这是四张卡而不是一个列表。
                                 米游社那张也占整行：它有自己的两个按钮和一段说明，切一半会挤成两行字。 -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- 不是 1:1：插件卡只需要放个名字和「打开目录」，
                                     通知卡里有一排渠道胶囊 + 正文模板 + 一个地址框，半宽会把胶囊挤成三行。 -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- v1.31：米游社签到。
                                 放最上面是因为它是唯一一张「要先登录才能用」的卡——
                                 藏在折叠列表底下的账号设置，等于没有。
                                 卡本身只说三件事：登没登、上次签到什么结果、现在能不能签。 -->
                            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}"
                                    Margin="0,0,0,0" Padding="16,13,16,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M3,16 L3,7 L10,2.5 L17,7 L17,16 Z M7.6,16 L7.6,10.4 L12.4,10.4 L12.4,16"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="米游社签到" FontSize="13.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbMiyousheState" Text="还没登录" FontSize="10.5"
                                                       Margin="10,2,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnMiyousheLogin" Content="登录" Style="{StaticResource MiniAction}"
                                                    Height="26" Padding="10,0" Margin="0,0,6,0"
                                                    Click="BtnMiyousheLogin_Click"/>
                                            <Button x:Name="BtnMiyousheSign" Content="现在签到" Style="{StaticResource MiniAction}"
                                                    Height="26" Padding="10,0" Click="BtnMiyousheSign_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TbMiyousheHint" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,8,0,0" LineHeight="18"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="在米游社按日签到能攒米游币。这里不碰你的密码——点「登录」会开一个小浏览器窗口，你在里面登录一次，凭证就存下来了。"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <ToggleButton x:Name="TgMiyousheAuto" Style="{StaticResource SwitchStyle}"
                                                      Click="TgMiyousheAuto_Click"/>
                                        <TextBlock Text="每次跑完一条龙顺手签一下" FontSize="11.5" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                            <!-- v1.29：插件卡。这里一直是空的——插件加载器（PluginLoader）在 v1.20 就写好了，
                                 但界面上没有一个地方能看见「装了没有、装了什么、为什么没装」。
                                 空着也是信息：先说清 plugins 目录在哪、放进去会长什么样，
                                 再去扫真实目录，把读得懂的和读不懂的分开列。 -->
                            <!-- 两列并排时，短的那张不跟着拉到别人那么高：插件卡空着的时候只有 60 高，
                                 被拉成和右边通知卡一样高，就是一大片什么都没有的底色。 -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}"
                                    Margin="0,10,7,0" Padding="0" VerticalAlignment="Top">
                                <StackPanel>
                                    <Button x:Name="BtnFoldPlugins" Style="{StaticResource FoldHeader}" Click="FoldHeader_Click">
                                        <DockPanel LastChildFill="False">
                                            <Path DockPanel.Dock="Right" x:Name="ChevPlugins" Data="M4 6l4 4 4-4"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.6"
                                                  Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <Path DockPanel.Dock="Left" Data="M10,3 L10,10 M10,13.5 L10,14.5 M3,3 L17,3 L17,17 L3,17 Z"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Left" Text="插件" FontSize="13.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TbPluginsSummary" DockPanel.Dock="Left" Text="" FontSize="10.5"
                                                       Margin="10,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Button>
                                    <StackPanel x:Name="PluginsBody" Margin="16,0,16,14" Visibility="Collapsed">
                                        <TextBlock Text="把一个插件文件夹放进 plugins\ 目录，重启管家就会出现在这里。每个插件要说清它要访问哪些域名、需要什么权限——写不明白的不加载。"
                                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <StackPanel x:Name="PluginsHost"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="BtnPluginsOpen" Content="打开插件目录" Style="{StaticResource MiniAction}"
                                                    Height="26" Padding="10,0" Click="BtnPluginsOpen_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 第三层：高级设置（默认折叠） -->

                    <!-- v1.33：外观。主题开关从标题栏搬走「自定义」之后，它需要一个落脚处。
                         单独一张卡而不是塞进系统里：它不是开关，是一套配色方案（底色/图/叠色/明暗），
                         点开是一个窗口——放在「系统」里会让人以为又是一项开关。 -->
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <Grid Margin="16,12,16,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="外观" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TbAppearanceSummary" FontSize="10.5" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <Button x:Name="BtnCustomTheme" Content="自定义配色…" Style="{StaticResource MiniAction}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="BtnCustomTheme_Click"
                                    ToolTip="选底色、放一张背景图、调叠色深浅、强制明暗"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <StackPanel>
                            <Button x:Name="BtnFoldAdvanced" Style="{StaticResource FoldHeader}" Click="FoldHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 3l7 4v5c0 4-3 7-7 9-4-2-7-5-7-9V7z" Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="高级设置" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="可选，日常不用改" FontSize="10.5" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid x:Name="AdvancedBody" Margin="16,0,16,14" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- v1.26：每一项一块自己的底。原来是一整片两列表格，
                                     靠 6px 空白分行，在深色底上读起来是一整块文字墙。 -->

                                <!-- v1.10 / G1：收益账本（默认关） -->
                                <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="收益账本" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="从 BGI 日志里累计摩拉/狗粮经验/拾取材料，队列结束时报一句" FontSize="10"
                                                       Margin="0,3,10,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TgHarvest" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgHarvest_Click"/>
                                    </Grid>
                                </Border>

                                <!-- v1.14：日志规则入口。规则本体在独立窗口——
                                     这张卡已经有 10 行了，再塞一个列表会把「高级设置」变成第二张主界面。 -->
                                <Border Grid.Row="8" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="日志规则" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="日志出现某个词就提醒 / 留现场 / 停下队列；可先扫今天的日志试一次" FontSize="10"
                                                       Margin="0,3,10,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <Button x:Name="BtnLogRules" Content="配置…" Style="{StaticResource MiniAction}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="BtnLogRules_Click"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <TextBlock Text="守护（存活/内存/截图）" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgSentinel" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgSentinel_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="崩溃后自动重启" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgAutoRestart" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoRestart_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <TextBlock Text="截图冻结检测" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgScreenshot" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgScreenshot_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="防打扰（定时等空闲）" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgIdleGuard" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgIdleGuard_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <TextBlock Text="定时前清理残留进程" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgAutoKill" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoKill_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="失败也执行跑完动作" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgAfterRunOnFailure" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAfterRunOnFailure_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <TextBlock Text="失败策略" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CbFailStrategy" Style="{StaticResource ThemedCombo}" Width="120" Height="30"
                                                  HorizontalAlignment="Right" SelectionChanged="CbFailStrategy_SelectionChanged">
                                            <ComboBoxItem Content="跳过继续" Tag="Skip"/>
                                            <ComboBoxItem Content="中止队列" Tag="Abort"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="工具间隔" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CbInterval" Style="{StaticResource ThemedCombo}" Width="120" Height="30"
                                                  HorizontalAlignment="Right" SelectionChanged="CbInterval_SelectionChanged">
                                            <ComboBoxItem Content="0 分钟" Tag="0"/>
                                            <ComboBoxItem Content="2 分钟" Tag="2"/>
                                            <ComboBoxItem Content="5 分钟" Tag="5"/>
                                            <ComboBoxItem Content="10 分钟" Tag="10"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="挂机护航" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="队列运行时阻止系统睡眠、更新重启与屏保" FontSize="10"
                                                       Margin="0,3,10,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TgKeepAwake" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgKeepAwake_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="夜间息屏" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="运行指定分钟数后关闭显示器，系统保持唤醒" FontSize="10"
                                                       Margin="0,3,10,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBox x:Name="TbNightMinutes" Style="{StaticResource InputBox}" Width="64" Height="30"
                                                     Padding="4,0" FontSize="12" TextAlignment="Center"
                                                     LostFocus="TbNightMinutes_LostFocus"/>
                                            <TextBlock Text="分" FontSize="10.5" Margin="4,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <ToggleButton x:Name="TgNightScreen" Style="{StaticResource SwitchStyle}"
                                                          VerticalAlignment="Center" Click="TgNightScreen_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="自动终止疑似挂起" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="默认只暂停队列等你处理；打开后结束进程并按失败策略继续" FontSize="10"
                                                       Margin="0,3,10,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TgStallAutoKill" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgStallAutoKill_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <TextBlock VerticalAlignment="Center" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="挂起判定：进程存活，但 CPU 低于 5% 且日志不增长持续 3 分钟。"/>
                                </Border>

                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="晨报" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="每天首次打开时用一句话汇报昨天跑了什么" FontSize="10"
                                                       Margin="0,3,10,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TgMorningReport" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgMorningReport_Click"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="周报" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="每周首次打开时汇报近七天：哪天跑得多、成功率、总耗时" FontSize="10"
                                                       Margin="0,3,10,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TgWeeklyReport" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgWeeklyReport_Click"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Margin="0,0,0,4">
