                                                ToolTip="跑完之后要打开哪个程序"/>
                                    </Grid>
                                    <Button x:Name="BtnQueueStart" Style="{StaticResource LaunchPrimary}" Height="44"
                                            Content="一键开跑" Click="BtnQueueStart_Click"/>
                                    <!-- v1.20 / 奇思妙想 #7：跑完收拾一下。放在「跑完后」下面而不是高级设置，
                                         因为它和那三件事是同一类：跑完之后机器会变成什么样。 -->
                                    <Grid x:Name="TidyRow" Margin="0,9,0,0">
                                        <TextBlock Text="跑完收拾一下" FontSize="11.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   ToolTip="关掉工具、把窗口放回原处；关游戏要另外打开。默认全关。"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="BtnTidyConfig" Content="设置…" Style="{StaticResource MiniAction}"
                                                    Height="26" Padding="10,0" Click="BtnTidyConfig_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- v1.6 / F2 接着跑：只补今天没跑成的项，已完成的组不重跑 -->
                                    <Button x:Name="BtnQueueContinue" Style="{StaticResource LaunchGhost}" Height="32"
                                            Content="接着跑（今天还剩 0 项）" Margin="0,7,0,0" Visibility="Collapsed"
                                            Click="BtnQueueContinue_Click"
                                            ToolTip="只跑今天还没跑成的工具；已完成的不会重复跑。"/>
                                    <Button x:Name="BtnQueueIdleSkip" Style="{StaticResource LaunchGhost}" Height="32"
                                            Content="立即开始（跳过等待）" Margin="0,7,0,0" Visibility="Collapsed"
                                            Click="BtnQueueIdleSkip_Click"/>
                                    <Button x:Name="BtnQueueCancelShutdown" Style="{StaticResource LaunchGhost}" Height="30"
                                            Content="取消关机" Margin="0,7,0,0" Visibility="Collapsed"
                                            Click="BtnQueueCancelShutdown_Click"/>
                                    <TextBlock x:Name="TbQueueHint" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="依次执行勾选的工具；间隔在高级设置里调整。"/>

                    <!-- v1.29：工具设置原来在设置页上单独一张卡，和这张卡说的是同一批工具——
                         「哪些要跑」在这边，「每个怎么跑」在那边，用户点一个工具得先想清楚它在哪一页。
