                                    <Grid Grid.Row="0" Margin="16,13,16,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource BrandSoftBrush}">
                                                <Path Data="M3,9.5 L10,3 L17,9.5 L17,16.5 L3,16.5 Z"
                                                      Stroke="{DynamicResource BrandTextBrush}" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="启动与界面" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="平时怎么用" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}"/>
                                    <ScrollViewer Grid.Row="2" Style="{StaticResource SetCardBody}" ScrollChanged="PageScrollChanged">
                                        <StackPanel>

                                    <Border Style="{StaticResource SetRow}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Style="{StaticResource SetLabel}" Text="外观"/>
                                                <Button x:Name="BtnCustomTheme" Content="自定义配色…" Style="{StaticResource MiniAction}"
                                                        Height="26" Padding="10,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Click="BtnCustomTheme_Click"
                                                        ToolTip="选底色、放一张背景图、调叠色深浅、强制明暗"/>
                                            </Grid>
                                            <TextBlock x:Name="TbAppearanceSummary" Style="{StaticResource SetHint}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="开机自动启动"/>
                                            <ToggleButton x:Name="TgAutoStart" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoStart_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="关闭时驻留托盘"/>
                                            <ToggleButton x:Name="TgStayTray" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgStayTray_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- v1.38：开机自启之后，启动时直接收进托盘、不弹窗口。
                                         自启的意思是「开机它就在」，不是「开机在你脸上开一扇窗」。 -->
                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="启动时最小化到托盘"/>
                                            <ToggleButton x:Name="TgStartMin" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgStartMin_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Style="{StaticResource SetLabel}" Text="收进托盘时释放窗口"/>
                                                <ToggleButton x:Name="TgTrimToTray" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgTrimToTray_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TbTrimHint" Style="{StaticResource SetHint}"
                                                       Text="实测只省 3.7 MB，但再打开一次要多等 1 秒多。想腾内存再开。"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="按键音效"/>
                                            <ToggleButton x:Name="TgSound" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgSound_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="迷你浮条（只显示进度）"/>
                                            <ToggleButton x:Name="TgMiniBar" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgMiniBar_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRowLast}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="跑完说一句话"/>
                                            <ToggleButton x:Name="TgSpeech" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgSpeech_Click"/>
                                        </Grid>
                                    </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                    </Grid>
                            </Border>
                            </StackPanel>
                        </Grid><!-- /SettingsCards -->
                            </StackPanel><!-- /SettingsSection -->
                        </Grid><!-- /PageSettings -->
                    </ScrollViewer>

                    <!-- ===== 第四页：插件（v1.34）=====
                         以前它是设置页里一张折叠卡，默认收起、还和通知卡挤同一排。
                         可插件是「要往里放东西」的地方——折叠着的入口等于让人自己猜它存在。
                         现在给它一整页：进来就看得见装了什么、装在哪、为什么没加载。 -->
                    <ScrollViewer x:Name="ScrollPlugins" VerticalScrollBarVisibility="Auto" ScrollChanged="PageScrollChanged"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform x:Name="ShiftPlugins" X="1960"/>
                        </ScrollViewer.RenderTransform>
                        <Grid x:Name="PagePlugins" Margin="14,10,14,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16,18,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M10,3 L10,10 M10,13.5 L10,14.5 M3,3 L17,3 L17,17 L3,17 Z"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="插件" FontSize="13.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbPluginsSummary" Text="" FontSize="10.5"
                                                       Margin="10,2,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <Button x:Name="BtnPluginsOpen" Content="打开插件目录"
                                                Style="{StaticResource MiniAction}" Height="26" Padding="10,0"
                                                HorizontalAlignment="Right" Click="BtnPluginsOpen_Click"/>
                                    </Grid>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="18"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="把一个插件文件夹放进插件目录，重启管家就会出现在下面。每个插件要在 metadata.json 里说清它要访问哪些域名、需要什么——写不明白的不加载。装坏了也不会让主程序起不来，只会在下面列成一条「没加载」并写明原因。"/>
                                    <StackPanel x:Name="PluginsHost" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14,18,14">
                                <StackPanel>
                                    <TextBlock Text="插件能做什么、不能做什么" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="能做：看当前跑没跑、跑的是哪个工具、今天还剩几个；借你配好的渠道发通知；记自己的日志和设置；要求开跑一次；读今天的日志尾巴。"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="不能做：改界面、停队列、动设置、读文件、访问任意网址。插件出问题时最坏的结果是它自己坏了。"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <!-- ===== 第五页：汇报（v1.40）=====
                         和日志页回答的是同一类问题——「已经发生的事」。
                         日志答「成没成、为什么没成」，这一页答「花了多久、时间去哪了」。
                         时长必须由队列记（它本来就拿秒表算超时和重试），
                         从日志里猜会碰上「中途卡住算多久」「重试算一次还是两次」这种没法猜的问题，
                         所以另立了一本账 DurationLedger，只记跑完的结果。 -->
                    <ScrollViewer x:Name="ScrollReport" VerticalScrollBarVisibility="Auto" ScrollChanged="PageScrollChanged"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform x:Name="ShiftReport" X="2450"/>
                        </ScrollViewer.RenderTransform>
                        <Grid x:Name="PageReport" Margin="14,10,14,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ===== 第 1 块：今天一共跑了多久 =====
                                 v1.41 / M5-5：合计行下面多一句「较昨日」。
                                 没有昨天的数就整句不出现——「昨天没跑」和「昨天跑了 0 秒」
                                 不是一回事，硬凑一句会让人以为对比过了。 -->
                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,16,18,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M3,17 L3,10 M8,17 L8,4 M13,17 L13,11 M18,17 L18,7"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="今天一共跑了多久" FontSize="13.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TbReportSummary" Text="" FontSize="10.5"
                                                       Margin="10,2,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <Button Content="刷新" Style="{StaticResource MiniAction}"
                                                HorizontalAlignment="Right" Click="BtnReportRefresh_Click"
                                                ToolTip="重新读一遍今天的账本"/>
                                    </Grid>

                                    <TextBlock x:Name="TbReportTotal" Text="还没跑过" FontSize="30" FontWeight="SemiBold"
                                               Margin="0,12,0,0" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TbReportTrend" Text="" FontSize="11.5" TextWrapping="Wrap"
                                               Margin="0,4,0,0" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock x:Name="TbReportHint" Text="" FontSize="11.5" TextWrapping="Wrap"
                                               Margin="0,6,0,0" LineHeight="18" MaxWidth="560"
                                               HorizontalAlignment="Left"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <!-- 最近 7 天：柱子用纯视觉的方式画（一个 Border 撑高度），不放 Chart。
                                         目的是「这几天有没有变多」，看个趋势就够。 -->
                                    <StackPanel x:Name="ReportBars" Orientation="Horizontal"
                                                Margin="0,16,0,0" Height="56" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TbReportBarsHint" Text="" FontSize="10.5"
                                               Margin="0,4,0,0" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>

                                    <!-- v1.41 / M5-2：「较上次」到底跟什么比，得写出来一次。
                                         不写的话，人会拿它去跟昨天比，然后觉得数字不对。 -->
                                    <TextBlock x:Name="TbReportComparedNote" Text=""
                                               FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                               HorizontalAlignment="Left"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- ===== 第 2 块：异常与处理（v1.41 / M5-4，放最前）=====
                                 这一块只写「出过事、并且管家真做了什么」。
                                 动作全部来自日志里真实写过的那几句，一条也不许编——
                                 宁可写「没有需要你操心的事」，也不要写一个没发生过的处理。 -->
                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14,18,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M12,3 L20,6.2 L20,12 C20,16 16.4,19.4 12,21 C7.6,19.4 4,16 4,12 L4,6.2 Z"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8"
                                                  StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="异常与处理" FontSize="13.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TbReportAnomalyHint" Text="" FontSize="10.5"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                    <StackPanel x:Name="ReportAnomalyHost" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ===== 第 3 块：配置组执行（v1.41 / M5-1）=====
                                 绝对耗时是普通字，差异值才是彩色 pill。
                                 两个都染上颜色，人会以为耗时本身也分好坏——
                                 跑得慢不等于出错，只是慢。 -->
                            <Border x:Name="ReportGroupCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14,18,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M4,6 L4,4.5 A1.5,1.5 0 0 1 5.5,3 L8.5,3 A1.5,1.5 0 0 1 10,4.5 L10,6 M5,6 L19,6 A1,1 0 0 1 20,7 L20,19 A1,1 0 0 1 19,20 L5,20 A1,1 0 0 1 4,19 L4,7 A1,1 0 0 1 5,6"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8"
                                                  StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="配置组执行" FontSize="13.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TbReportGroupHint" Text="" FontSize="10.5"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                    <StackPanel x:Name="ReportGroupHost" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ===== 第 4 块：每个工具 ===== -->
                            <Border x:Name="ReportToolCard" Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14,18,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M4,7 L9,7 L11,4 L20,4 L20,19 L4,19 Z"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8"
                                                  StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="每个工具" FontSize="13.5" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TbReportToolHint" Text="" FontSize="10.5"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                    <StackPanel x:Name="ReportToolHost" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ===== 第 5 块：空分区合并（v1.41 / M5-3）=====
                                 两个以上分区都只有「暂无」时，合成这一行放在末尾。
                                 空分区名由代码填，不写死——写死的话新加一个分区就会漏。 -->
                            <TextBlock x:Name="TbReportEmptyMerge" Text="" Grid.Row="4"
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                                       Margin="2,12,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14,18,14">
                                <StackPanel>
                                    <TextBlock Text="这个数是哪来的" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="每次工具跑完，队列把自己掐的秒表读数和开始时那一刻记下来，就是你看到的这个数。跳过的不算、中途手动停下的那次算到停为止。"/>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="配置组那一段是「这次跑的时候，BetterGI 内部正好在哪个组上」。组还没结束的不计——宁可少记一个组，也不给一个猜出来的数。"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- ===== 日志视图（v1.41 / M1-2）=====
                 它不再是底栏的一页，而是一层「带着问题进来」的覆盖视图：
                 进来时带 {runId?, toolId?, date?} 三个过滤条件，多个条件取交集。
                 顶部那行「正在看：…」把当前条件明写出来——不然筛过之后
                 少了几行，人会以为日志丢了。
                 关掉它就回到原来那一页，底栏四项不变。 -->
            <Grid x:Name="LogLayer" Grid.Row="1" Panel.ZIndex="15" Visibility="Collapsed"
                  Background="{DynamicResource InsetBrush}">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="PageScrollChanged" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="PageRun" Margin="14,10,14,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 过滤条：把「现在在筛什么」写在最上面 -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,11,16,11">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M3,4 L17,4 L11.5,10.5 L11.5,16.5 L8.5,15 L8.5,10.5 Z"
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TbLogFilter" Text="正在看：全部日志" FontSize="12.5"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TbLogCount" Text="" FontSize="10.5" VerticalAlignment="Center"
                                               Margin="0,0,10,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <Button Content="关闭" Style="{StaticResource MiniAction}" Height="26" Padding="10,0"
                                            Click="BtnLogClose_Click" ToolTip="回到刚才那一页"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 原来日志页那两张卡：一个字没改，只是搬到这里当正文的头一段 -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,16,18,16">
                            <StackPanel>
                                <TextBlock Text="刚才跑了什么" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TbRunState" Text="" FontSize="19" FontWeight="SemiBold"
                                           Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TbRunDetail" Text="" FontSize="12.5" Margin="0,8,0,0"
                                           TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel x:Name="RunDecisionHost" Margin="0,14,0,0"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Style="{StaticResource LaunchGhost}" Height="32" Content="今日详情"
                                            Click="BtnRunToday_Click"
                                            ToolTip="每组跑了多久、哪一项没成、它替你做了哪些决定"/>
                                    <Button Style="{StaticResource LaunchGhost}" Height="32" Content="打开日志"
                                            Margin="8,0,0,0" Click="BtnRunLog_Click"
                                            ToolTip="打开日志文件夹，看原始文件"/>
                                    <!-- M3-6：常用的两个留在外面，其余收进「更多」。
                                         收的理由很简单：这三个按钮里只有「今日详情」是每天都点的，
                                         另外两个一周也用不上一次，却一直占着一行最显眼的位置。 -->
                                    <Button x:Name="BtnRunMore" Style="{StaticResource LaunchGhost}" Height="32"
                                            Margin="8,0,0,0" Click="BtnRunMore_Click"
                                            ToolTip="还有几个不常点的">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="更多" VerticalAlignment="Center"/>
                                            <TextBlock Text="▾" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="RunMoreMenu">
                                                <MenuItem Header="出门前看一眼" Click="BtnRunHandover_Click"
                                                          ToolTip="接下来几天它会做什么、哪些兜不住"/>
                                                <!-- M1-3：全量日志的兜底入口。不带任何条件，
                                                     从哪一页点都到得了完整的一天。 -->
                                                <MenuItem Header="全部日志" Click="BtnRunAllLogs_Click"
                                                          ToolTip="今天记下的每一条，不做任何筛选"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14,18,14">
                            <StackPanel>
                                <TextBlock Text="时间账" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TbRunBank" Text="" FontSize="12.5" Margin="0,8,0,0"
                                           TextWrapping="Wrap" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TbRunBaseline" Text="" FontSize="12.5" Margin="0,6,0,0"
                                           TextWrapping="Wrap" HorizontalAlignment="Left" Visibility="Collapsed"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- 日志正文：一行一条，时间列用等宽数字对齐 -->
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18,14,18,14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="日志" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TbLogHint" Text="" FontSize="10.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                                <StackPanel x:Name="LogListHost" Margin="0,10,0,0"/>
                                <TextBlock x:Name="TbLogEmpty" Text="" FontSize="12.5" Margin="0,10,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- v1.32/v1.33/v1.34：悬浮标签栏。
                 v1.33 修了两处：
                 ① 它原来占自己一行（Grid.Row="2"），于是窗口为了它多长出一截，卡片区被顶短。
                    现在它坐在内容区里（Row 1）浮在最上层，卡片从它底下滚过去——这才是「悬浮」。
                 ② 点击没反应。原因是按下就 CaptureMouse()，鼠标被这块 Border 抢走，
                    底下的 RadioButton 收不到完整的按下/松开序列，Checked 永远不会触发。
                    现在只有真的拖出 4px 才捕获，纯点击一律让给按钮自己。

                 v1.34 三处：
                 ① 四项（日志 / 主页 / 设置 / 插件）。原来三项里「运行」这名字说的是「状态」，
                    但那一页放的全是已经发生过的事——叫「日志」才对得上里面的内容，图标换成翻开的书。
                 ② 外壳改成真正的液态玻璃：不再是「一块实心 CardBg2 + 一根描边」，
                    而是一层半透明白、顶部一道高光、底边一道冷色反光——见下面的三层叠法。
                    同时也要能看见底下的卡片在动，所以外面不能再铺不透明底色。
                 ③ 插件单独一页，不再挤在设置里当一张折叠卡。

                     v1.37：页面底部留白 88 → 96。胶囊高 58、离窗口底 14，加起来 72；
                 88 只多出 16px 呼吸，而卡片最后一行（比如「一键开跑」按钮）在
                 900×480 这个最小尺寸下正好落在胶囊后面——截图里按钮被压住一半。
                 96 让最后一行完整地停在胶囊上方。 -->
            <Grid Grid.Row="1" Panel.ZIndex="20" Background="Transparent"
                  VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border x:Name="NavShell" HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5"
                        CornerRadius="27" Padding="5" Height="58"
                        PreviewMouseLeftButtonDown="NavShell_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="NavShell_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="NavShell_PreviewMouseLeftButtonUp">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavShellShift" Y="0"/>
                    </Border.RenderTransform>
                    <!-- 液态玻璃外壳：三层。外面不写 Background，让底下的卡片透上来一点。 -->
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D9181C22" Offset="0"/>
                            <GradientStop Color="#CC12151A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                                          Opacity="0.5" Color="#FF05070A"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 会滑的那块底。宽高跟单个标签项一致，靠 TranslateTransform 走位。 -->
                        <Border x:Name="NavPill" Width="84" Height="46" CornerRadius="19"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource BrandSoftBrush}" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavPillShift" X="0"/>
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel x:Name="NavItemsHost" Orientation="Horizontal">

                        <!-- 日报：四根柱子高低不一（「这几天各花了多久」）。
                             v1.40 新增，v1.41 起站到最左边——「日志」那一页退出底栏之后，它就是唯一的「回头看」。
                             为什么不用时钟：时钟说的是「现在几点」，这一页说的是「已经用掉多少」，
                             柱状图一眼能看出多寡，时钟要读秒针。 -->
                        <RadioButton x:Name="SegPageReport" Tag="0"
                                     Style="{StaticResource NavBtn}" Checked="SegPage_Checked"
                                     ToolTip="今天每个工具、每个配置组各跑了多久">
                            <StackPanel>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M3,17 L3,10 M8,17 L8,4 M13,17 L13,11 M18,17 L18,7"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="日报" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 主页：房子（「接下来几点跑」，每天回来的那一页）。
                             v1.34 之前叫「启动」——但进门的那一页不只是「启动」，它是整个软件的正门。 -->
                        <RadioButton x:Name="SegPageHome" Tag="1" IsChecked="True"
                                     Style="{StaticResource NavBtn}" Checked="SegPage_Checked"
                                     ToolTip="定时、任务清单、一键开跑">
                            <StackPanel>
                                <Path Data="M3,9.5 L10,3 L17,9.5 L17,16.5 L3,16.5 Z" Width="18" Height="18"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="主页" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 设置：两根滑杆（「把东西配好」） -->
                        <RadioButton x:Name="SegPageSettings" Tag="2"
                                     Style="{StaticResource NavBtn}" Checked="SegPage_Checked"
                                     ToolTip="工具、通知、系统和插件">
                            <StackPanel>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M2,5.5 L16,5.5 M2,12.5 L16,12.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Margin="9,3,0,0"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Ellipse Width="4" Height="4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                             Margin="4,0,0,3"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                                <TextBlock Text="设置" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 插件：一块拼图 + 插口。
                             v1.34 新增。它以前是设置页里一张默认收起的折叠卡——要往里放东西的入口，
                             折叠着等于让人自己猜它存在。 -->
                        <RadioButton x:Name="SegPagePlugins" Tag="3"
                                     Style="{StaticResource NavBtn}" Checked="SegPage_Checked"
                                     ToolTip="装了哪些、装在哪、为什么没加载">
                            <StackPanel>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center">
                                    <Path Data="M3,3 L8,3 A1.6,1.6 0 0 1 11,3 L15,3 L15,7.5 A1.6,1.6 0 0 0 15,11 L15,15 L10,15 A1.6,1.6 0 0 0 7,15 L3,15 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="插件" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="10.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部状态条：守护盾牌 + 最近一条事件 -->
            <Border Grid.Row="2" x:Name="StatusBarBorder" Background="{DynamicResource InsetBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Height="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Background="Transparent"
                                MouseEnter="Shield_MouseEnter" MouseLeave="Shield_MouseLeave">
                        <Ellipse x:Name="ShieldDot" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource TextTertiaryBrush}"/>
                        <Path Data="M12 3l7 4v5c0 4-3 7-7 9-4-2-7-5-7-9V7z" Stroke="{DynamicResource TextTertiaryBrush}"
                              StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShieldText" Text="守护未开启" FontSize="10.5" Margin="5,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Border x:Name="ShieldTip" Visibility="Collapsed" Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="10,7" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ShieldTipText" FontSize="10.5" TextWrapping="Wrap" MaxWidth="520"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TbLog" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="12,0,10,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
