                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== E 系统（折叠，默认收起；6 开关两列网格）===== -->
                    <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <StackPanel>
                            <Button x:Name="BtnFoldSystem" Style="{StaticResource FoldHeader}" Click="FoldHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 5h18v14H3z M3 9h18" Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="系统" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid x:Name="SystemBody" Margin="16,0,16,14" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- v1.26：每一项一块自己的底（见 SettingCard 样式的注释）。 -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <TextBlock Text="开机自动启动" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgAutoStart" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoStart_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="软件启动后自动跑" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgAutoRun" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoRun_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <TextBlock Text="关闭时驻留托盘" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgStayTray" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgStayTray_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="度假模式（暂停所有定时）" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgVacation" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgVacation_Click"/>
                                    </Grid>
                                </Border>

                                <!-- v1.21 内存方案 B：默认关。理由写在这里，省得以后有人以为是漏了默认开。 -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="收进托盘时释放窗口" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="TgTrimToTray" Style="{StaticResource SwitchStyle}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgTrimToTray_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="TbTrimHint" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Text="实测只省 3.7 MB，但再打开一次要多等 1 秒多。想腾内存再开。"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="按键音效" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgSound" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgSound_Click"/>
                                    </Grid>
                                </Border>

                                <!-- v1.7 F6：本机控制 API（默认关，令牌可复制） -->
                                <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="本机控制 API" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="TgControlApi" Style="{StaticResource SwitchStyle}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgControlApi_Click"/>
                                        </Grid>
                                        <TextBlock Text="让脚本和 AI 助手用自然语言以外的方式指挥它：开跑、停止、查状态。只监听 127.0.0.1，关着时连「有这个接口」都不会暴露。"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <Grid x:Name="ApiTokenRow" Margin="0,6,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="令牌" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Grid.Column="1" Background="{DynamicResource InsetBrush}" CornerRadius="6" Padding="8,5">
                                                <TextBlock x:Name="TbApiToken" FontFamily="Consolas" FontSize="11.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Button x:Name="BtnCopyToken" Grid.Column="2" Content="复制" Style="{StaticResource LinkButton}"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnCopyToken_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- v1.7 F7：局域网只读面板（默认关，只读不给控制） -->
                                <Border Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="手机看进度（局域网只读面板）" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="TgLanPanel" Style="{StaticResource SwitchStyle}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgLanPanel_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="TbLanPanelHint"
                                                   Text="打开后同一 Wi-Fi 下的手机浏览器可以看进度和最近一条事件，但没有任何按钮——只能看，不能指挥。"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- v1.8 F9：全局热键（默认关，游戏反作弊容忍度不可控） -->
                                <Border Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="全局热键（游戏里也能按）" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="TgHotkey" Style="{StaticResource SwitchStyle}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgHotkey_Click"/>
                                        </Grid>
                                        <TextBlock Text="默认关：全局热键会霸占组合键，部分游戏的反作弊也会盯着这类注册，要不要用由你决定。"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <Grid x:Name="HotkeyRow" Margin="0,6,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="开跑" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="TbHotkeyStart" Grid.Column="1" Text="Ctrl+Alt+R" FontSize="11.5"
                                                     LostFocus="TbHotkeyStart_LostFocus"/>
                                            <TextBlock Grid.Column="2" Text="停止" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,8,0"/>
                                            <TextBox x:Name="TbHotkeyStop" Grid.Column="3" Text="Ctrl+Alt+S" FontSize="11.5"
                                                     LostFocus="TbHotkeyStop_LostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- v1.8 F11/F14：浮条与语音（都默认关） -->
                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,7,8">
                                    <Grid>
                                        <TextBlock Text="迷你浮条（只显示进度）" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgMiniBar" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgMiniBar_Click"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="跑完说一句话" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TgSpeech" Style="{StaticResource SwitchStyle}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgSpeech_Click"/>
                                    </Grid>
                                </Border>

                                <!-- v1.17：备份与恢复（唯一一个「点一下会换掉现有东西」的入口，所以措辞刻意啰嗦） -->
                                <Border Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="备份设置" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnBackupNow" Content="存一份" Style="{StaticResource MiniAction}"
                                                        Height="26" Padding="10,0" Click="BtnBackupNow_Click"/>
                                                <Button x:Name="BtnBackupRestore" Content="从包恢复" Style="{StaticResource MiniAction}"
                                                        Height="26" Padding="10,0" Margin="6,0,0,0" Click="BtnBackupRestore_Click"/>
                                                <Button x:Name="BtnBackupOpen" Content="打开文件夹" Style="{StaticResource MiniAction}"
                                                        Height="26" Padding="10,0" Margin="6,0,0,0" Click="BtnBackupOpen_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="TbBackupHint"
                                                   Text="把设置、配置组常用、运行台账和个人收益记录打成一个 zip；一条龙配置要不要一起带上，在弹窗里选。恢复前会先把现在这份备份一次。"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- v1.19：开跑前体检。放这里而不是队列卡标题行——那边已经有五个按钮，
                                     再加一个就把标题压没了（v1.15 修过一次）。真正的拦截在「一键开跑」上，
                                     这里只是一个能随时自己打开看的入口。 -->
                                <Border Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="开跑前体检" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnPreflight" Content="检查一下" Style="{StaticResource MiniAction}"
                                                        Height="26" Padding="10,0" Click="BtnPreflight_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="TbPreflightHint"
                                                   Text="看路径、队列、配置组、通知有没有没弄好的地方。只读，不改任何东西；开跑时也会自动查一遍，只有真挡路的才会拦你。"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- v1.20：出门前看一眼。和体检同一套位置的道理——它是一年用一次的东西，
                                     不该占主界面的固定面积。 -->
                                <Border Grid.Row="9" Grid.ColumnSpan="2" Style="{StaticResource SettingCard}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="出门前看一眼" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnHandover" Content="看这几天会发生什么" Style="{StaticResource MiniAction}"
                                                        Height="26" Padding="10,0" Click="BtnHandover_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="TbHandoverHint"
                                                   Text="先说要出几天，它把这段时间里会发生什么、哪几件会让这趟白跑，列成人话。只读。"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== F 通知（折叠，默认收起）===== -->
                    <Border x:Name="NotifyCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"
                            Margin="7,10,0,0" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Button x:Name="BtnFoldNotify" Style="{StaticResource FoldHeader}" Click="FoldHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6 9a6 6 0 1 1 12 0c0 4 2 5 2 5H4s2-1 2-5z M10 21h4"
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="通知" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="NotifyBody" Margin="16,0,16,14" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="推送渠道" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
