                                                    HorizontalAlignment="Left" Margin="0,8,0,0" Height="26" Padding="10,0"
                                                    Click="BtnCopyWebhook_Click"/>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>                               <!-- v1.41 / M4-1：报告从「节奏与报告」里拆出来，归到通知这一类——这两件事都是「跑完怎么告我」。 -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0" VerticalAlignment="Top">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="16,13,16,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource BrandSoftBrush}">
                                                <Path Data="M4,3 L16,3 A1,1 0 0 1 17,4 L17,16 A1,1 0 0 1 16,17 L4,17 A1,1 0 0 1 3,16 L3,4 A1,1 0 0 1 4,3 M6.5,7 L13.5,7 M6.5,10.5 L13.5,10.5 M6.5,14 L10.5,14"
                                                      Stroke="{DynamicResource BrandTextBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="报告" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="跑完怎么告诉你" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}"/>
                                    <ScrollViewer Grid.Row="2" Style="{StaticResource SetCardBody}" ScrollChanged="PageScrollChanged">
                                        <StackPanel>
                                        <Border Style="{StaticResource SetRow}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Style="{StaticResource SetLabel}" Text="晨报"/>
                                                    <ToggleButton x:Name="TgMorningReport" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgMorningReport_Click"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource SetHint}" Text="每天首次打开时用一句话汇报昨天跑了什么"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SetRow}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Style="{StaticResource SetLabel}" Text="周报"/>
                                                    <ToggleButton x:Name="TgWeeklyReport" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgWeeklyReport_Click"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource SetHint}" Text="每周首次打开时汇报近七天：哪天跑得多、成功率、总耗时"/>
                                            </StackPanel>
                                        </Border>

