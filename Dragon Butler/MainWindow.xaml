                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TbPath_march7th" Style="{StaticResource InputBox}" IsReadOnly="True" Height="32"/>
                                    <Button Grid.Column="1" Content="浏览" Style="{StaticResource MiniAction}" Margin="8,0,0,0"
                                            Click="ToolBrowse_Click" Tag="march7th"/>
                                    <Button Grid.Column="2" Content="自动寻找" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolAutoFind_Click" Tag="march7th"/>
                                    <Button Grid.Column="3" Content="测试启动" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolTest_Click" Tag="march7th"/>
                                    <Button Grid.Column="4" Content="换图标" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolIcon_Click" Tag="march7th" ToolTip="换成你喜欢的图标（.ico / .exe / .png）"/>
                                </Grid>
                                <TextBlock x:Name="TbFindHint_march7th" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <StackPanel>
                            <Button x:Name="BtnFold_okww" Style="{StaticResource FoldHeader}" Click="ToolHeader_Click" Tag="ok-ww">
                                <DockPanel LastChildFill="False">
                                    <Path DockPanel.Dock="Right" x:Name="Chev_okww" Data="M4 6l4 4 4-4"
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.6"
                                          Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="7"
                                            Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <TextBlock x:Name="IconText_okww" Text="W" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="IconImage_okww" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Left" Text="ok-ww" FontSize="13.5" FontWeight="SemiBold"
                                               Margin="8,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Left" x:Name="TbToolState_okww" Text="未配置" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DockPanel>
                            </Button>
                            <StackPanel x:Name="Body_okww" Margin="16,0,16,14" Visibility="Collapsed">
                                <TextBlock Text="程序位置（点「自动寻找」多数情况不用手填）" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TbPath_okww" Style="{StaticResource InputBox}" IsReadOnly="True" Height="32"/>
                                    <Button Grid.Column="1" Content="浏览" Style="{StaticResource MiniAction}" Margin="8,0,0,0"
                                            Click="ToolBrowse_Click" Tag="ok-ww"/>
                                    <Button Grid.Column="2" Content="自动寻找" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolAutoFind_Click" Tag="ok-ww"/>
                                    <Button Grid.Column="3" Content="测试启动" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolTest_Click" Tag="ok-ww"/>
                                    <Button Grid.Column="4" Content="换图标" Style="{StaticResource MiniAction}" Margin="6,0,0,0"
                                            Click="ToolIcon_Click" Tag="ok-ww" ToolTip="换成你喜欢的图标（.ico / .exe / .png）"/>
                                </Grid>
                                <TextBlock x:Name="TbFindHint_okww" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 自定义工具（v1.4）：运行时生成卡片 -->
                    <StackPanel x:Name="CustomToolsHost"/>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="自定义工具" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="任意 exe 都能接入：填路径、进程名和完成方式即可。" FontSize="10.5"
                                           Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <Button Content="＋ 添加" Style="{StaticResource MiniAction}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="BtnAddCustomTool_Click"/>
                        </Grid>
                    </Border>
                            </StackPanel>
                        </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== 右页：设置 =====
                         工具、通知、系统这些「配一次就不常动」的东西全在这页。
                         它们以前压在中页下面，得滚很久；现在右滑一步就到，
                         而中页从此只剩「今晚跑什么」这件事。 -->
                    <ScrollViewer x:Name="ScrollSettings" VerticalScrollBarVisibility="Auto" ScrollChanged="PageScrollChanged"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform x:Name="ShiftSettings" X="980"/>
                        </ScrollViewer.RenderTransform>
                        <Grid x:Name="PageSettings" Margin="14,10,14,22">
                            <!-- v1.41 / M4-1：设置页分成两层。
                                 一级只有五张入口卡（守护 / 定时 / 通知 / 接口 / 界面与启动），
                                 点哪张进哪张，二级里才是真正的开关。
                                 以前所有开关平铺在两列卡片墙上，找一个开关得先记住它在哪张卡里；
                                 现在先问「你要改的是哪一类事」，答案只有五个。
                                 M4-3 预留：将来改成「长页滚动 + 左侧锚点」时，
                                 只需要把 SettingsSection 换成锚点布局，入口卡退化成书签，路由结构不用动。 -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ===== 一级：五张入口卡 ===== -->
                            <StackPanel x:Name="SettingsHome">
                                <TextBlock Text="想改哪一类？" FontSize="12" Margin="2,0,0,10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <WrapPanel x:Name="SettingsEntryHost"/>

                                <!-- v1.41 / M2-12：没走完五步的人，这里指一下向导还在。
                                     走完了就把这句收起来——已经不需要了。 -->
                                <TextBlock x:Name="TbSettingsWizardHint" Margin="2,14,0,0" FontSize="11"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="还没走完首次使用那五步。想补上，去主页点引导卡里的任意一项就行。"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- ===== 二级：某一类的全部开关 ===== -->
                            <StackPanel x:Name="SettingsSection" Grid.Row="1" Visibility="Collapsed">
                                <Button x:Name="BtnSettingsBack" Click="BtnSettingsBack_Click" Margin="0,0,0,10"
                                        HorizontalAlignment="Left" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Padding="2,4,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M9 4 L4 9 L9 14" Stroke="{DynamicResource TextSecondaryBrush}"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TbSettingsSectionName" Text="全部设置" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Button>

                            <Grid x:Name="SettingsCards">
                            <!-- ===== 五个二级分区 =====
                                 一级只有五张入口卡，点进来才铺开这个分区的全部开关。
                                 分区的分工按「你什么时候会想改它」切，不按代码里的类：
                                 守护 = 跑的时候出事怎么办；定时 = 几点跑、跑完睡不睡；
                                 通知 = 跑完怎么告我；接口 = 给外面的东西开口；界面与启动 = 平时怎么用。 -->
                            <StackPanel x:Name="SecGuard" Visibility="Collapsed" Margin="0,0,0,4">
                            <!-- ===== 守护与恢复 ===== -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0" VerticalAlignment="Top">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="16,13,16,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource BrandSoftBrush}">
                                                <Path Data="M12 3l7 4v5c0 4-3 7-7 9-4-2-7-5-7-9V7z"
                                                      Stroke="{DynamicResource BrandTextBrush}" StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="守护与恢复" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="跑的时候它盯着" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}"/>
                                    <ScrollViewer Grid.Row="2" Style="{StaticResource SetCardBody}" ScrollChanged="PageScrollChanged">
                                        <StackPanel>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="守护（存活/内存/截图）"/>
                                            <ToggleButton x:Name="TgSentinel" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgSentinel_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="崩溃后自动重启"/>
                                            <ToggleButton x:Name="TgAutoRestart" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoRestart_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="截图冻结检测"/>
                                            <ToggleButton x:Name="TgScreenshot" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgScreenshot_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Style="{StaticResource SetLabel}" Text="自动终止疑似挂起"/>
                                                <ToggleButton x:Name="TgStallAutoKill" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgStallAutoKill_Click"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SetHint}" Text="默认只暂停队列等你处理；打开后结束进程并按失败策略继续"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Style="{StaticResource SetLabel}" Text="定时前清理残留进程"/>
                                                <ToggleButton x:Name="TgAutoKill" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoKill_Click"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SetHint}" Text="开跑前先把上一局没退干净的进程收掉，免得它和新的抢同一份存档。"/>
                                        </StackPanel>
                                    </Border>

                                        <Border Style="{StaticResource SetRow}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Style="{StaticResource SetLabel}" Text="日志规则"/>
                                                    <Button x:Name="BtnLogRules" Content="配置…" Style="{StaticResource MiniAction}"
                                                            Height="26" Padding="10,0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Click="BtnLogRules_Click"/>
                                                </Grid>
                                                <TextBlock Style="{StaticResource SetHint}" Text="日志出现某个词就提醒 / 留现场 / 停下队列；可先扫今天的日志试一次"/>
                                            </StackPanel>
                                        </Border>

                                    <Border Style="{StaticResource SetRowLast}">
                                        <TextBlock Style="{StaticResource SetHint}" Margin="0"
                                                   Text="「挂起」的判定：进程还活着，但 CPU 低于 5% 且日志不增长，已经持续 3 分钟。"/>
                                    </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                    </Grid>
                            </Border>
                            </StackPanel>

                            <StackPanel x:Name="SecTiming" Visibility="Collapsed" Margin="0,0,0,4">
                            <!-- v1.41 / M4-1：原来叫「节奏与报告」，报告那一半搬去「通知」了，这里只剩「几点跑、中间歇多久、跑的时候别睡」。 -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0" VerticalAlignment="Top">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="16,13,16,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource BrandSoftBrush}">
                                                <Path Data="M3,13 L6.5,13 L9,6.5 L13,16 L15.5,11 L18,11"
                                                      Stroke="{DynamicResource BrandTextBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="定时与节奏" FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="几点跑、中间歇多久" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}"/>
                                    <ScrollViewer Grid.Row="2" Style="{StaticResource SetCardBody}" ScrollChanged="PageScrollChanged">
                                        <StackPanel>

                                    <Border Style="{StaticResource SetRow}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Style="{StaticResource SetLabel}" Text="防打扰（定时等空闲）"/>
                                                <ToggleButton x:Name="TgIdleGuard" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgIdleGuard_Click"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SetHint}" Text="到点了先看你还在不在用电脑，正在用就等一等。"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="失败策略"/>
                                            <ComboBox x:Name="CbFailStrategy" Style="{StaticResource ThemedCombo}" Width="120" Height="30"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="CbFailStrategy_SelectionChanged">
                                                <ComboBoxItem Content="跳过继续" Tag="Skip"/>
                                                <ComboBoxItem Content="中止队列" Tag="Abort"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="工具间隔"/>
                                            <ComboBox x:Name="CbInterval" Style="{StaticResource ThemedCombo}" Width="120" Height="30"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="CbInterval_SelectionChanged">
                                                <ComboBoxItem Content="0 分钟" Tag="0"/>
                                                <ComboBoxItem Content="2 分钟" Tag="2"/>
                                                <ComboBoxItem Content="5 分钟" Tag="5"/>
                                                <ComboBoxItem Content="10 分钟" Tag="10"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource SetLabel}" Text="失败也执行跑完动作"/>
                                            <ToggleButton x:Name="TgAfterRunOnFailure" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAfterRunOnFailure_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Style="{StaticResource SetLabel}" Text="挂机护航"/>
                                                <ToggleButton x:Name="TgKeepAwake" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgKeepAwake_Click"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SetHint}" Text="队列运行时阻止系统睡眠、更新重启与屏保"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SetRow}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Style="{StaticResource SetLabel}" Text="夜间息屏"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBox x:Name="TbNightMinutes" Style="{StaticResource InputBox}" Width="64" Height="30"
                                                             Padding="4,0" FontSize="12" TextAlignment="Center"
                                                             LostFocus="TbNightMinutes_LostFocus"/>
                                                    <TextBlock Text="分" FontSize="10.5" Margin="4,0,8,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    <ToggleButton x:Name="TgNightScreen" Style="{StaticResource SwitchStyle}"
                                                                  VerticalAlignment="Center" Click="TgNightScreen_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SetHint}" Text="运行指定分钟数后关闭显示器，系统保持唤醒"/>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                    </Grid>
                            </Border>
                            </StackPanel>

                            <StackPanel x:Name="SecNotify" Visibility="Collapsed" Margin="0,0,0,4">
                            <!-- ===== 通知（折叠，默认收起）=====
                                 v1.35：整块挪到第一排占满，后面四张卡按「守护 / 界面 / 节奏 / 接口」两两并排。 -->
                            <Border x:Name="NotifyCard" Style="{StaticResource Card}"
                            Margin="0,0,0,0" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Button x:Name="BtnFoldNotify" Style="{StaticResource FoldHeader}" Click="FoldHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6 9a6 6 0 1 1 12 0c0 4 2 5 2 5H4s2-1 2-5z M10 21h4"
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="通知" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="NotifyBody" Margin="16,0,16,14" Visibility="Collapsed">
                                <ScrollViewer x:Name="NotifyScroll" Style="{StaticResource SetCardBody}" MaxHeight="330">
                                    <StackPanel>
                                        <Grid>
                                        <TextBlock Text="推送渠道" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TbNotifyChannelState" HorizontalAlignment="Right" FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton x:Name="ChipOff" Content="不推送" Tag="Off" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipToast" Content="Windows 通知" Tag="Toast" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipBalloon" Content="托盘气泡" Tag="Balloon" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipWecom" Content="企业微信" Tag="Wecom" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipFeishu" Content="飞书" Tag="Feishu" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipDing" Content="钉钉" Tag="DingTalk" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipTelegram" Content="Telegram" Tag="Telegram" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipBark" Content="Bark" Tag="Bark" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipEmail" Content="邮件" Tag="Email" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipXxtui" Content="xxtui" Tag="Xxtui" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipWebhook" Content="自定义 Webhook" Tag="Webhook" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                        <RadioButton x:Name="ChipWebSocket" Content="WebSocket" Tag="WebSocket" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TbNotifyHint" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>

                                    <!-- 本地渠道说明 -->
                                    <StackPanel x:Name="NpLocal" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock x:Name="TbLocalHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- 企业微信 -->
                                    <StackPanel x:Name="NpWecom" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock Text="企业微信群机器人 Webhook" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbNotifyWecom" Tag="NotifyWecomUrl" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                        <TextBlock Text="群设置 → 群机器人 → 添加机器人 → 复制 Webhook 地址"
                                                   FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- 飞书 -->
                                    <StackPanel x:Name="NpFeishu" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock Text="飞书自定义机器人 Webhook" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbNotifyFeishu" Tag="NotifyFeishuUrl" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                        <TextBlock Text="签名校验密钥（可选；机器人开启「签名校验」时填写）"
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                        <TextBox x:Name="TbNotifyFeishuSecret" Tag="NotifyFeishuSecret" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>

                                    <!-- 钉钉 -->
                                    <StackPanel x:Name="NpDing" Visibility="Collapsed" Margin="0,10,0,0">
