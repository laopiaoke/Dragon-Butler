<Window x:Class="DragonButler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DragonButler"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="一条龙管家" Width="980" SizeToContent="Height" MinWidth="900" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        Closing="Window_Closing">

    <!-- 自绘标题栏 + 系统级缩放边框；圆角交给 Win11 DWM（Win10 退化为直角） -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 键盘焦点环（2px 品牌色，替换系统虚线框） -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource BrandBrush}" BorderThickness="2" CornerRadius="10" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片容器（§2：圆角 14、内边距 16、1px 边） -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- 启动台主按钮：全宽 44、圆角 9、品牌实心 + 深色字；hover 蒙白 7%、pressed 下沉 1px -->
        <Style x:Key="LaunchPrimary" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                                <Border x:Name="HoverVeil" Background="White" Opacity="0" CornerRadius="9" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 启动台次按钮：全宽 32、幽灵样式（透明底 + 1px BorderStrong） -->
        <Style x:Key="LaunchGhost" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <!-- 普通扁平按钮（次按钮：透明底 + 1px 描边，hover 提亮一档） -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（§4：高 38、圆角 9、品牌色底深色字；按压位移由代码驱动） -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="176"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 星期胶囊（§3：7px 圆角；选中=品牌色描边 + 品牌色 12% 底） -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="9,3"
                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 折叠卡标题行（§4：高 46、整行可点、chevron 随展开旋转） -->
        <Style x:Key="FoldHeader" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="13" Height="44">
                            <Grid Margin="16,0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path x:Name="Chev" Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="open">
                                <Setter TargetName="Chev" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关（§4：38×21，轨道圆角 12，滑块 15，切换 120ms 缓动） -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="38" Height="21">
                            <Border x:Name="OffBg" CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                            <Border x:Name="OnBg" CornerRadius="12" Background="{DynamicResource BrandBrush}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="15" Height="15" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" Margin="3,0,3,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobT" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OnBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="17" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OnBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框（§4：高 34、Inset 底、聚焦转品牌色描边、无系统 3D 边框） -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题化下拉框 -->
        <Style x:Key="ThemedCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource InsetBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}"
                                              IsHitTestVisible="False" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Margin="12,0,28,0"/>
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondaryBrush}"
                                  IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource InsetBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MaxHeight="220">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉项 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 现代感滚动条：细圆角滑块，悬停加深（隐式样式，作用于 ScrollViewer 内部滚动条） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBg" CornerRadius="4" Margin="2,0" Opacity="0.5"
                                                        Background="{DynamicResource TextSecondaryBrush}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主题化复选框 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="3"
                                    Background="{DynamicResource InsetBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 2 7 L 5.5 10.5 L 12 3" Stroke="White"
                                      StrokeThickness="2" Opacity="0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分段式主题切换按钮（§5：三段式，选中态=容器高亮块） -->
        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Height="24" Padding="11,0">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 定时大数字按钮：去掉系统默认按钮 chrome（避免点击出现蓝色按压块） -->
        <Style x:Key="TimeDisplayButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要文字链接（配置组详情 / 更改路径等低视觉权重入口） -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 配置组勾选项：选中=品牌柔光底+品牌描边；左侧徽章位固定宽度，勾选后显示执行序号 -->
        <Style x:Key="GroupCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="7" Padding="8,4"
                                Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 推送渠道胶囊（10 个渠道，多行自动换行） -->
        <Style x:Key="NotifyChip" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Height="26" Padding="9,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 守护卡快捷动作（立刻启动 / 停止） -->
        <Style x:Key="MiniAction" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 守护条「详情」按钮：无边框文字 + chevron，hover 提亮 -->
        <Style x:Key="GuardDetailBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏窗口按钮（最小化/关闭）：hover 提亮一档，无边框 -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" CornerRadius="16" Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 自定义主题背景层：图片 + 遮罩（默认透明，预设主题下不参与绘制） -->
            <Border Grid.RowSpan="3" CornerRadius="15" IsHitTestVisible="False"
                    Background="{DynamicResource BgArtBrush}"/>
            <Border Grid.RowSpan="3" CornerRadius="15" IsHitTestVisible="False"
                    Background="{DynamicResource ScrimBrush}"/>

            <!-- 标题栏：应用标记 + 名称 / 分段主题 / 最小化 / 关闭（空白处可拖动） -->
            <Grid Grid.Row="0" Background="{DynamicResource CardBgBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- 应用标记：盘龙环抱龙珠 + 8:00 指针（与 §6 图标同几何） -->
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="512" Height="512">
                            <Path Data="M408.6,215.1 A158,158 0 1 1 296.9,103.4"
                                  Stroke="{DynamicResource BrandBrush}" StrokeThickness="46"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="321.7" Canvas.Top="98.3" Width="92" Height="92"
                                     Fill="{DynamicResource BrandBrush}"/>
                            <Path Data="M256,268 L256,200 M256,268 L211,294"
                                  Stroke="{DynamicResource BrandBrush}" StrokeThickness="14"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="247" Canvas.Top="259" Width="18" Height="18"
                                     Fill="{DynamicResource BrandBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="一条龙管家" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                        Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SegDark" Content="深色" Tag="Dark"
                                     Style="{StaticResource SegBtn}" Checked="SegTheme_Checked"/>
                        <RadioButton x:Name="SegLight" Content="浅色" Tag="Light"
                                     Style="{StaticResource SegBtn}" Checked="SegTheme_Checked"/>
                        <RadioButton x:Name="SegSystem" Content="跟随系统" Tag="System"
                                     Style="{StaticResource SegBtn}" Checked="SegTheme_Checked"/>
                        <RadioButton x:Name="SegCustom" Content="自定义" Tag="Custom"
                                     Style="{StaticResource SegBtn}" Checked="SegTheme_Checked"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="3" x:Name="BtnMinWin" Content="—" Style="{StaticResource WinBtn}"
                        Margin="0,0,2,0" VerticalAlignment="Center" Click="BtnMinWin_Click"
                        ToolTip="最小化"/>
                <Button Grid.Column="4" x:Name="BtnCloseWin" Content="✕" Style="{StaticResource WinBtn}"
                        Margin="0,0,6,0" VerticalAlignment="Center" Click="BtnCloseWin_Click"
                        ToolTip="关闭（可在托盘继续运行）"/>
            </Grid>

            <!-- 内容区：单页、无导航、一屏装完（§3） -->
            <ScrollViewer Grid.Row="1" x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="14,10,14,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 红色横幅（Critical 通知） -->
                    <Border Grid.Row="0" x:Name="BannerBorder" Visibility="Collapsed" CornerRadius="9" Padding="12,8"
                            Margin="0,0,0,12" Background="{DynamicResource DangerBrush}">
                        <TextBlock x:Name="BannerText" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- ===== A：定时区（左 1.12）/ 守护区（右 1）===== -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.12*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- A-1 定时卡：概览页 / 编辑页 双页切换（手机式推入动画） -->
                        <Border x:Name="ScheduleCard" Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ScheduleBar" Grid.Column="0" Background="{DynamicResource BrandBrush}"
                                        Width="4" Margin="1,12,0,12" CornerRadius="2"
                                        HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <Grid Grid.Column="1" Margin="16,14,16,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 标题栏：图标 + 动态标题 + 开关/返回 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M4 6h16v15H4z M4 11h16 M8 3v4 M16 3v4"
                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ScheduleTitle" Text="每天自动跑一条龙" FontSize="13.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton x:Name="TgSchedule" Style="{StaticResource SwitchStyle}"
                                                          VerticalAlignment="Center" Click="TgSchedule_Click"/>
                                            <Button x:Name="BtnScheduleBack" Content="← 返回" Style="{StaticResource FlatButton}"
                                                    Height="26" Padding="9,0" Visibility="Collapsed"
                                                    Click="BtnScheduleBack_Click" ToolTip="返回定时概览"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 页面容器：概览页 / 编辑页（固定最小高度，切换不跳高度） -->
                                    <Grid Grid.Row="1" x:Name="SchedulePageHost" Margin="0,4,0,0"
                                          ClipToBounds="True">

                                        <!-- 概览页：时间正中，重复日在上、说明与倒计时在下 -->
                                        <Grid x:Name="ScheduleOverview" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="OverviewScale" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="OverviewShift" X="0" Y="0"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- 上：重复日（贴近时间上方） -->
                                            <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Margin="0,0,0,12">
                                                <TextBlock Text="重复日" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <WrapPanel x:Name="WeekdayChips" HorizontalAlignment="Center">
                                                    <ToggleButton x:Name="ChipEvery" Content="每天" Style="{StaticResource Chip}"
                                                                  Tag="All" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipMon" Content="一" Style="{StaticResource Chip}" Tag="0" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipTue" Content="二" Style="{StaticResource Chip}" Tag="1" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipWed" Content="三" Style="{StaticResource Chip}" Tag="2" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipThu" Content="四" Style="{StaticResource Chip}" Tag="3" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipFri" Content="五" Style="{StaticResource Chip}" Tag="4" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipSat" Content="六" Style="{StaticResource Chip}" Tag="5" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipSun" Content="日" Style="{StaticResource Chip}" Tag="6" Click="WeekdayChip_Click"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- 中：时间（卡片垂直正中） -->
                                            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                                                <Button x:Name="BtnTimeDisplay" Style="{StaticResource TimeDisplayButton}"
                                                        HorizontalAlignment="Center" Click="BtnTimeDisplay_Click"
                                                        ToolTip="点击修改时间">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBlock x:Name="TbTimeDisplay" Text="08:00"
                                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                                   FontSize="58" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="准时自动启动" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="10,0,0,8" VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="点击时间可修改" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 下：说明 + 上次执行 + 倒计时（贴近时间下方） -->
                                            <StackPanel Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center"
                                                        Margin="0,12,0,0">
                                                <TextBlock Text="到点自动拉起 BetterGI 并执行一条龙，无需开软件"
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TbLastRun" Text="上次执行：暂无记录" FontSize="11.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                <Rectangle Height="1" Margin="0,12,0,0" Stroke="{DynamicResource BorderBrush}"
                                                           StrokeThickness="1" StrokeDashArray="3 3" Fill="{DynamicResource BorderBrush}"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                    <Ellipse x:Name="NextDot" Width="7" Height="7" Fill="{DynamicResource BrandBrush}"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TbCountdown" Text="距下次执行 —" FontSize="11.5"
                                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 编辑页：时间选择器（整页覆盖，推入/推出） -->
                                        <Border x:Name="TimePickerPanel" Visibility="Collapsed"
                                                Background="{DynamicResource CardBg2Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="8,4,8,8"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="EditorScale" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="EditorShift" X="0" Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <local:TimePickerControl x:Name="TimePicker" VerticalAlignment="Center"
                                                                     Confirmed="TimePicker_Confirmed" Cancelled="TimePicker_Cancelled"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- A-2 守护卡：状态胶囊 + 当前运行带 + 4 路实时指标 + 心跳 + 今日组 + 最近事件 -->
                                                <!-- A-2 启动台：全屏唯一启动入口（头部计数 + 两行状态 + 主/次按钮 + 进度 + 上次执行） -->
                        <Border x:Name="LaunchCard" Grid.Column="1" Style="{StaticResource Card}"
                                Margin="7,0,0,0" Padding="16,14,16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- a) 头部行：电源图标 + 启动台 / 今日完成数 -->
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M12 3v8 M7.5 6.5a7 7 0 1 0 9 0"
                                          Stroke="{DynamicResource BrandBrush}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="启动台" FontSize="13.5" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="SentinelCountText" Text="今日 0 组"
                                               FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               ToolTip="分母 = 已勾选的配置组数量"/>
                                </Grid>

                                <!-- b) 状态区：两行固定高度（文案切换不改卡片高度） -->
                                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                                 Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="StatusText" Text="BetterGI 未运行"
                                                   FontSize="18" FontWeight="Medium" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock x:Name="BigHint" Text="点下面的按钮，或等 08:00 自动开始"
                                               Height="18" FontSize="12" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- c) 主按钮：唯一启动入口（图标位固定 16px，starting 时换成旋转指示器） -->
                                <Button Grid.Row="3" x:Name="BigBtn" Style="{StaticResource LaunchPrimary}"
                                        Click="BigBtn_Click"
                                        RenderTransformOrigin="0.5,0.5"
                                        PreviewMouseLeftButtonDown="BigBtn_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="BigBtn_PreviewMouseLeftButtonUp"
                                        MouseLeave="BigBtn_MouseLeave"
                                        ToolTip="忽略定时设置，立即启动一条龙">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="BigBtnShift" X="0" Y="0"/>
                                    </Button.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Path x:Name="BigBtnIconPlay" Data="M5 3.2 L18.2 12 L5 20.8 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  Stretch="Uniform" Width="13" Height="13"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Rectangle x:Name="BigBtnIconStop" Width="11" Height="11" RadiusX="1.5" RadiusY="1.5"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                            <Path x:Name="BigBtnSpinner" Data="M8 1.6 A6.4 6.4 0 1 1 1.6 8"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="BigBtnSpinnerRotate" Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                        <TextBlock Grid.Column="1" x:Name="BigBtnText" Text="立刻启动一条龙"
                                                   FontSize="15" FontWeight="Medium" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                    </Grid>
                                </Button>

                                <!-- d) 次按钮：仅启动 BGI（不跑一条龙） -->
                                <Button Grid.Row="4" x:Name="BtnStartBgi" Style="{StaticResource LaunchGhost}"
                                        Margin="0,8,0,0" Click="BtnStartBgi_Click"
                                        ToolTip="只启动 BetterGI，不执行一条龙">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="M12 3v8 M7.5 6.5a7 7 0 1 0 9 0"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.75"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Text="仅启动 BGI（不跑一条龙）" FontSize="11.5" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- e) 进度条：仅 starting / running 显示（不定态流动，不假报百分比） -->
                                <Border Grid.Row="5" x:Name="RunProgressTrack" Height="4" CornerRadius="2" Margin="0,10,0,0"
                                        Background="{DynamicResource ControlBgBrush}" ClipToBounds="True"
                                        Visibility="Collapsed">
                                    <Rectangle x:Name="RunProgressFlow" Width="160" RadiusX="2" RadiusY="2"
                                               HorizontalAlignment="Left" Fill="{DynamicResource BrandBrush}">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="RunProgressShift" X="-160"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>

                                <!-- f) 上次执行 -->
                                <TextBlock Grid.Row="6" x:Name="TbLastRunLaunch" Text="上次：暂无记录"
                                           FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border></Grid>

                    <!-- ===== B 守护条（通栏细条：折叠 56 / 展开 2×2 明细 + 心跳线）===== -->
                    <Border x:Name="GuardStrip" Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <StackPanel>
                            <!-- 折叠态头部：整条可点；异常时底色转 Warning 12% + 出现「需要处理」徽章 -->
                            <Border x:Name="GuardStripHeader" Height="56" Background="Transparent" Cursor="Hand"
                                    CornerRadius="14" MouseLeftButtonUp="GuardStripHeader_MouseUp"
                                    ToolTip="点击展开 / 收起守护明细">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="GuardStripShield"
                                          Data="M12 3l7 3v6c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6l7-3z"
                                          Stroke="{DynamicResource BrandBrush}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,0,10,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="GuardStripTitle" Text="守护已开启" FontSize="13.5"
                                                   FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Ellipse x:Name="GuardStripDot" Width="4" Height="4" Margin="10,0,10,0"
                                                 Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GuardStripSummary"
                                                   Text="崩溃重启 · 内存 · 冻结检测 · 进度识别 四项正常"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"/>
                                    </StackPanel>

                                    <!-- 守护关闭时的开启入口（避免整条只读） -->
                                    <StackPanel x:Name="SentinelClosedBar" Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                                        <Button x:Name="BtnSentinelOn" Content="开启守护" Style="{StaticResource LinkButton}"
                                                Click="BtnSentinelOn_Click"/>
                                    </StackPanel>

                                    <Border x:Name="GuardStripBadge" Grid.Column="3" Visibility="Collapsed"
                                            CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Background="{DynamicResource WarningBrush}">
                                        <TextBlock x:Name="GuardStripBadgeText" Text="需要处理" FontSize="10"
                                                   FontWeight="Medium" Foreground="{DynamicResource WindowBgBrush}"/>
                                    </Border>

                                    <Button Grid.Column="4" Grid.ColumnSpan="2" x:Name="BtnGuardDetail"
                                            Style="{StaticResource GuardDetailBtn}" Click="GuardStripToggle_Click"
                                            ToolTip="展开 / 收起守护明细（键盘可操作）">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="GuardStripDetail" Text="详情" FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                            <Path x:Name="GuardStripChevron" Data="M 0 0 L 5 5 L 10 0"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Margin="7,1,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="GuardStripChevronRotate" Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 展开态：2×2 明细 + 今日组 + 最近事件 + 心跳线 -->
                            <StackPanel x:Name="GuardStripBody" Visibility="Collapsed">
                                <UniformGrid x:Name="SentinelFeatures" Columns="2" Margin="14,0,8,0">
                                    <!-- 崩溃自动重启 -->
                                    <Border Background="{DynamicResource CardBg2Brush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,6,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M20 12a8 8 0 1 1-2.3-5.7 M20 4v5h-5"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="崩溃自动重启" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="FeatRestartDetail" Text="本次 0 次" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="FeatRestartDot" Width="6" Height="6"
                                                         Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="FeatRestartStatus" Text="未开始" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 内存监控 -->
                                    <Border Background="{DynamicResource CardBg2Brush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,6,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M7 7h10v10H7z M10 3v4 M14 3v4 M10 17v4 M14 17v4 M3 10h4 M3 14h4 M17 10h4 M17 14h4"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="内存监控" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="FeatMemDetail" Text="系统 -- · BGI --" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="FeatMemDot" Width="6" Height="6"
                                                         Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="FeatMemStatus" Text="未开始" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 画面冻结检测 -->
                                    <Border Background="{DynamicResource CardBg2Brush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,6,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M3 5h18v11H3z M9 20h6 M12 16v4"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="画面冻结检测" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="FeatShotDetail" Text="等待检查" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="FeatShotDot" Width="6" Height="6"
                                                         Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="FeatShotStatus" Text="未开始" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 进度识别 -->
                                    <Border Background="{DynamicResource CardBg2Brush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,6,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M4 20v-9 M10 20V4 M16 20v-6 M21 20H3"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="进度识别" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="FeatProgressDetail" Text="等待首个事件" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="FeatProgressDot" Width="6" Height="6"
                                                         Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="FeatProgressStatus" Text="未开始" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <!-- 今日配置组（最多 3 条）+ 继续跑未完成 -->
                                <StackPanel Margin="14,8,14,0">
                                    <ItemsControl x:Name="SentinelList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontSize="11" Foreground="{Binding IconColor}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="10"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="BtnContinue" Content="▶ 继续跑未完成（0 组）" Style="{StaticResource FlatButton}"
                                            Margin="0,6,0,0" Height="28" HorizontalAlignment="Left" Visibility="Collapsed"
                                            Click="BtnContinue_Click"/>
                                </StackPanel>

                                <!-- 最近事件 -->
                                <Border Margin="14,10,14,0" Padding="9,7" CornerRadius="8"
                                        Background="{DynamicResource CardBg2Brush}">
                                    <StackPanel>
                                        <TextBlock Text="最近事件" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="TbEventsEmpty" Text="暂无事件 · 启动一条龙后这里会记录"
                                                   FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,4,0,0"/>
                                        <ItemsControl x:Name="SentinelEvents" Margin="0,3,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}" FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                        <Ellipse Grid.Column="1" Width="5" Height="5" Fill="{Binding DotColor}"
                                                                 Margin="4,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 底部：心跳线（高 28，双线圆头）
                                     布局约定：心电画布与状态文字是**两个独立列**，文字列宽度写死，
                                     文案变长（"已连续 9 次 · 12 秒前"）只在自己列内重排/省略，
                                     绝不会挤压或拉伸心电画布（旧版 Auto 列会随文案改画布宽度）。 -->
                                <Grid Margin="14,10,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="158"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas x:Name="HeartCanvas" Grid.Column="0" Height="28" ClipToBounds="True"
                                            Background="Transparent" Cursor="Hand"
                                            MouseLeftButtonDown="HeartCanvas_MouseLeftButtonDown"
                                            ToolTip="心电图：颜色与波形反映一条龙状态（双击可循环预览各状态）"/>
                                    <TextBlock Grid.Column="2" x:Name="TbHeartHint" Text="等待首次检查" FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                               TextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== C 执行配置组（通栏卡片；勾选顺序即执行顺序，实时生效）===== -->
                    <Border x:Name="GroupsCard" Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12,16,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M4 6h16 M4 12h16 M4 18h10 M16 15.5l2.2 2.2 3.3-3.6"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="执行配置组" FontSize="13.5" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="TbGroupSummary" Text="未选择 · 将使用一条龙配置名"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="12,0,8,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="3" x:Name="BtnGroupDetails" Content="配置组详情"
                                        Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                        Click="BtnGroupDetails_Click"
                                        ToolTip="查看配置组来源与识别状态"/>
                            </Grid>

                            <ScrollViewer MaxHeight="74" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                            <ItemsControl x:Name="GroupPickList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource GroupCheck}" Margin="0,0,8,5"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Click="GroupPickCheck_Click" ToolTip="{Binding Name}">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 徽章位固定宽度：未选=空心圆，已选=序号（执行顺序） -->
                                                <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1"
                                                             Visibility="{Binding OrderEmptyVisibility}"/>
                                                    <Border CornerRadius="8" Background="{DynamicResource BrandBrush}"
                                                            Visibility="{Binding OrderVisibility}">
                                                        <TextBlock Text="{Binding OrderText}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrandOnBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           MaxWidth="168" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="TbGroupPickEmpty" Visibility="Collapsed" FontSize="10.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="1,5,0,1"
                                       Text="还没有配置组（全新 BetterGI 属于正常；在 BGI 调度器里建组后会自动出现）"/>

                            <!-- 次要入口：识别详情与重新识别（默认收起，不占主要视觉） -->
                            <StackPanel x:Name="GroupPickPanel" Visibility="Collapsed" Margin="0,7,0,1">
                                <TextBlock x:Name="TbGroupScan" FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="BtnRescanGroups" Content="重新识别" Style="{StaticResource LinkButton}"
                                            Padding="0,1" Click="BtnRescanGroups_Click"/>
                                    <Button x:Name="BtnOpenGroupDir" Content="打开配置目录" Style="{StaticResource LinkButton}"
                                            Margin="12,0,0,0" Padding="0,1" Click="BtnOpenGroupDir_Click"
                                            ToolTip="在资源管理器中打开 BetterGI\User\ScriptGroup"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== D 一条龙配置（折叠，默认展开）===== -->
                    <Border x:Name="DragonCard" Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <StackPanel>
                            <Button x:Name="BtnFoldSettings" Style="{StaticResource FoldHeader}" Tag="open" Click="FoldHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4 7h16 M4 12h16 M4 17h16" Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="1.75" StrokeStartLineCap="Round" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="一条龙配置" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="SettingsBody" Margin="16,0,16,14">
                                <!-- BGI 路径：次要信息常驻显示（省略号截断 + 悬停全路径 + 点击复制） -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BetterGI 路径" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="TbPathText" Text="未设置 BetterGI 路径"
                                               FontSize="10.5" Margin="10,0,8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" Cursor="Hand"
                                               MouseLeftButtonUp="TbPathText_MouseLeftButtonUp"/>
                                    <TextBlock Grid.Column="2" x:Name="TbPathCopied" Text="已复制" FontSize="10"
                                               Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center"
                                               Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Grid.Column="3" x:Name="BtnChangePath" Content="更改" Style="{StaticResource LinkButton}"
                                            VerticalAlignment="Center" Click="BtnBrowse_Click"
                                            ToolTip="重新选择 BetterGI.exe"/>
                                </Grid>
                                <TextBlock Text="一条龙配置名" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
                                <TextBlock Text="留空则使用 BetterGI 里当前选中的配置；勾选上方配置组时以配置组为准"
                                           FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBox x:Name="TbConfigName" Style="{StaticResource InputBox}" Margin="0,6,0,0"
                                         LostFocus="TbConfigName_LostFocus" TextChanged="TbConfigName_TextChanged"/>
                                <TextBlock x:Name="TbConfigScan" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== E 系统（折叠，默认收起；6 开关两列网格）===== -->
                    <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <StackPanel>
                            <Button x:Name="BtnFoldSystem" Style="{StaticResource FoldHeader}" Click="FoldHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 5h18v14H3z M3 9h18" Stroke="{DynamicResource TextTertiaryBrush}"
                                          StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="系统" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid x:Name="SystemBody" Margin="16,0,16,14" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,6,14,6">
                                    <TextBlock Text="开机自动启动" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="TgAutoStart" Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoStart_Click"/>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,6,0,6">
                                    <TextBlock Text="软件启动后自动跑" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="TgAutoRun" Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoRun_Click"/>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,6,14,6">
                                    <TextBlock Text="关闭时驻留托盘" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="TgStayTray" Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgStayTray_Click"/>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,6">
                                    <TextBlock Text="守护 BetterGI" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="TgSentinel" Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgSentinel_Click"/>
                                </Grid>
                                <Grid Grid.Row="2" Grid.Column="0" Margin="0,6,14,6">
                                    <TextBlock Text="崩溃后自动重启" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="TgAutoRestart" Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgAutoRestart_Click"/>
                                </Grid>
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,6,0,6">
                                    <TextBlock Text="按键音效" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="TgSound" Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="TgSound_Click"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== F 通知（折叠，默认收起）===== -->
                    <Border x:Name="NotifyCard" Grid.Row="6" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <StackPanel>
                            <Button x:Name="BtnFoldNotify" Style="{StaticResource FoldHeader}" Click="FoldHeader_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6 9a6 6 0 1 1 12 0c0 4 2 5 2 5H4s2-1 2-5z M10 21h4"
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="通知" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="NotifyBody" Margin="16,0,16,14" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="推送渠道" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TbNotifyChannelState" HorizontalAlignment="Right" FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <WrapPanel Margin="0,6,0,0">
                                    <RadioButton x:Name="ChipToast" Content="Windows 通知" Tag="Toast" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipBalloon" Content="托盘气泡" Tag="Balloon" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipWecom" Content="企业微信" Tag="Wecom" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipFeishu" Content="飞书" Tag="Feishu" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipDing" Content="钉钉" Tag="DingTalk" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipTelegram" Content="Telegram" Tag="Telegram" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipBark" Content="Bark" Tag="Bark" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipEmail" Content="邮件" Tag="Email" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipXxtui" Content="xxtui" Tag="Xxtui" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipWebhook" Content="自定义 Webhook" Tag="Webhook" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                    <RadioButton x:Name="ChipWebSocket" Content="WebSocket" Tag="WebSocket" Style="{StaticResource NotifyChip}" Checked="NotifyChip_Checked"/>
                                </WrapPanel>
                                <TextBlock x:Name="TbNotifyHint" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>

                                <!-- 本地渠道说明 -->
                                <StackPanel x:Name="NpLocal" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock x:Name="TbLocalHint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 企业微信 -->
                                <StackPanel x:Name="NpWecom" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="企业微信群机器人 Webhook" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyWecom" Tag="NotifyWecomUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="群设置 → 群机器人 → 添加机器人 → 复制 Webhook 地址"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 飞书 -->
                                <StackPanel x:Name="NpFeishu" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="飞书自定义机器人 Webhook" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyFeishu" Tag="NotifyFeishuUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="签名校验密钥（可选；机器人开启「签名校验」时填写）"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                    <TextBox x:Name="TbNotifyFeishuSecret" Tag="NotifyFeishuSecret" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                </StackPanel>

                                <!-- 钉钉 -->
                                <StackPanel x:Name="NpDing" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="钉钉自定义机器人 Webhook" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyDing" Tag="NotifyDingUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="加签密钥（可选；安全设置选「加签」时填写）"
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                    <TextBox x:Name="TbNotifyDingSecret" Tag="NotifyDingSecret" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                </StackPanel>

                                <!-- Telegram -->
                                <Grid x:Name="NpTelegram" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Bot Token" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbNotifyTelegramToken" Tag="NotifyTelegramToken" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Chat ID" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbNotifyTelegramChat" Tag="NotifyTelegramChat" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="找 @BotFather 建机器人拿 Token；Chat ID 可先给机器人发消息，再访问 getUpdates 获取"/>
                                </Grid>

                                <!-- Bark -->
                                <StackPanel x:Name="NpBark" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="Bark 推送地址（含设备 Key）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyBark" Tag="NotifyBarkUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="示例：https://api.day.app/你的Key（可填自建服务器地址）"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 邮件 -->
                                <Grid x:Name="NpEmail" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="SMTP 服务器" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailHost" Tag="NotifyEmailHost" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="端口（465/587）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailPort" Tag="NotifyEmailPort" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock Text="SMTP 用户名" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailUser" Tag="NotifyEmailUser" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock Text="密码 / 授权码" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailPass" Tag="NotifyEmailPass" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock Text="发件人（留空=用户名）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailFrom" Tag="NotifyEmailFrom" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock Text="收件人（多个用分号）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TbEmailTo" Tag="NotifyEmailTo" Style="{StaticResource InputBox}"
                                                 Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- xxtui -->
                                <StackPanel x:Name="NpXxtui" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="xxtui API 地址或 API Key" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyXxtui" Tag="NotifyXxtuiUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="只填 Key 会自动补全为 https://www.xxtui.com/xxtui/Key"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 自定义 Webhook -->
                                <StackPanel x:Name="NpWebhook" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="自定义 Webhook 地址" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyWebhook" Tag="NotifyWebhookUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="POST JSON：source / level / title / message / timestamp"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- WebSocket -->
                                <StackPanel x:Name="NpWebSocket" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="WebSocket 地址（ws:// 或 wss://）" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TbNotifyWebSocket" Tag="NotifyWebSocketUrl" Style="{StaticResource InputBox}"
                                             Margin="0,5,0,0" LostFocus="NotifyField_LostFocus"/>
                                    <TextBlock Text="连接成功后发送一条 JSON 即关闭（与 BetterGI 的 WebSocket 行为一致）"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 推送频率 -->
                                <Grid Margin="0,12,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="只推送异常" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="开启后「一条龙启动/完成」不推送，只推异常与卡死"
                                                   FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="TgNotifyOnlyImportant" Style="{StaticResource SwitchStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Click="TgNotifyOnlyImportant_Click"/>
                                </Grid>

                                <!-- 测试 -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnTestWebhook" Content="发送测试消息" Style="{StaticResource FlatButton}"
                                            Height="30" Padding="12,0" Click="BtnTestWebhook_Click"/>
                                    <TextBlock Grid.Column="1" x:Name="TbNotifyTestResult" FontSize="11" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>

                                <!-- 可选：BGI Webhook（不填也能自动识别配置组） -->
                                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="9"
                                        Background="{DynamicResource CardBg2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="进度识别（可选）" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="TbBgiWebhookHint" FontSize="10.5" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                        <Button x:Name="BtnCopyWebhook" Content="复制地址" Style="{StaticResource FlatButton}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Height="26" Padding="10,0"
                                                Click="BtnCopyWebhook_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- 底部状态条 -->
            <Border Grid.Row="2" x:Name="StatusBarBorder" Visibility="Collapsed" Background="{DynamicResource InsetBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="TbLog" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Margin="10,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </Grid>
    </Border>
</Window>
