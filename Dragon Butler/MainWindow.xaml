<Window x:Class="DragonButler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DragonButler"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="一条龙管家" Width="1080" Height="720" MinWidth="880" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop"
        DragLeave="OnWindowDragLeave"
        Closing="Window_Closing">

    <!-- v1.40：窗口改成固定高度 780，不再 SizeToContent="Height"。
         以前窗口高度等于「最高的那一页」（设置页 1334）再被 MaxHeight 夹到工作区，
         结果每一页都被撑到上限，主页下面空出一大块——用户说的「浪费空间」就是这个。
         现在窗口自己定高、每页各滚各的，谁长谁滚，短的那页不留白。
         代价是矮屏（工作区 < 800）上窗口会被夹，所以导航做了「上滑显示、下滑收起」。 -->

    <!-- 自绘标题栏 + 系统级缩放边框；圆角交给 Win11 DWM（Win10 退化为直角） -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 键盘焦点环（2px 品牌色，替换系统虚线框） -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource BrandBrush}" BorderThickness="2" CornerRadius="10" Margin="-2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片容器（§2：圆角 14、内边距 16、1px 边） -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- 启动台主按钮：全宽 44、圆角 9、品牌实心 + 深色字；hover 蒙白 7%、pressed 下沉 1px -->
        <Style x:Key="LaunchPrimary" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                                <Border x:Name="HoverVeil" Background="White" Opacity="0" CornerRadius="9" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- v1.37：禁用时不能只把绿底调到 55% 透明——那样看着像「还没加载完」，
                                     不像「现在不能用」。换成冷灰底 + 灰字，一眼就知道点不了。
                                     注意：字色要设在 Bd 的 TextElement.Foreground 上——模板触发器
                                     改不到模板父（Button 自己）的 Foreground，那会被 Style 的
                                     Setter 压回去，结果是深色字贴在灰底上，比原来还难读。 -->
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 启动台次按钮：全宽 32、幽灵样式（透明底 + 1px BorderStrong） -->
        <Style x:Key="LaunchGhost" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>        <!-- 普通扁平按钮（次按钮：透明底 + 1px 描边，hover 提亮一档） -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（§4：高 38、圆角 9、品牌色底深色字；按压位移由代码驱动） -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="176"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 星期胶囊（§3：7px 圆角；选中=品牌色描边 + 品牌色 12% 底） -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="9,3"
                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 折叠卡标题行（§4：高 46、整行可点、chevron 随展开旋转） -->
        <Style x:Key="FoldHeader" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="13" Height="44">
                            <Grid Margin="16,0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path x:Name="Chev" Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="open">
                                <Setter TargetName="Chev" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v1.26：设置项自己的底。
             高级设置与系统原来是两张长长的两列表格，行与行之间只靠 6px 空白分开——
             在深色底上读起来是一整块文字墙，一眼扫不出「一共有几件事」。
             现在每一项给一块比卡片浅一档的底（CardBg2）+ 10 圆角，靠留白分开。
             不画描边：一格一格的线会连成网格，比不画还乱。 -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg2Brush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9,12,9"/>
        </Style>

        <!-- v1.35：设置页改成卡片墙之后，卡里的一行设置。
             不再给每行套一块浅底的方块——卡自己已经是浅底了，行再套一层就变成「盒子里的盒子」，
             一行一条横线似的方块叠起来，正是用户说的「一个一个长条」。
             现在只靠留白和一条极淡的分隔线分区，最后一行不画线（画了会顶到卡的圆角上）。 -->
        <Style x:Key="SetRow" TargetType="Border">
            <Setter Property="Padding" Value="16,11,16,11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- 同一张卡里的最后一行：不画底部分隔线 -->
        <Style x:Key="SetRowLast" TargetType="Border" BasedOn="{StaticResource SetRow}">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 一行设置的名字 -->
        <Style x:Key="SetLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ===== v1.41 / M6-2 与 M6-4：新增界面的间距与字号 =====
             这一版新做的东西（日志视图、设置一级入口卡、向导的时间页与进度条、
             首访引导卡、日报的差异 pill）按下面这套来：
               间距  8 / 12 / 16 / 24 / 32（8 的倍数），不出现 7、13、19 这种数；
               圆角  卡片 12、按钮 6、chip 全圆角胶囊；
               字号  主标题 18–20/600、卡片标题 15–16/600、正文 14/400（行高 22）、
                     辅助 13/400（透明度降 20%）、按钮 14/600；
               数字  一律 tabular-nums，时长和条数上下要对得齐。
             为什么只约束「新增」：老的界面是三年里一格一格调出来的，
             整体重刷会把这些年攒下的手感一起抹掉，也不在这次的改动范围里。
             现有 Card 样式仍是圆角 14、MiniAction 仍是 30 高 11.5 号字——
             这些没在这次改动的界面里，保持原样（见待人工确认清单）。 -->
        <!-- 一行设置的补充说明：只在真的需要解释时才写，写完就收嘴 -->
        <Style x:Key="SetHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
        <!-- v1.41：卡内滚动条。
             以前每张卡都跟着内容长高，四张卡谁也不一样高、滚到底还得猜「下面还有没有」。
             现在卡是固定高度，内容多的那几张自己滚——滚的是这张卡，不是整页。
             内层滚动条不吃滚轮，所以要把滚轮自己转回外层（见 SetCardBody_MouseWheel）。 -->
        <Style x:Key="SetCardBody" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="0,0,2,0"/>
            <Setter Property="Focusable" Value="False"/>
            <EventSetter Event="PreviewMouseWheel" Handler="SetCardBody_MouseWheel"/>
        </Style>

        <!-- 开关（§4：38×21，轨道圆角 12，滑块 15，切换 120ms 缓动） -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="38" Height="21">
                            <Border x:Name="OffBg" CornerRadius="12" Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                            <Border x:Name="OnBg" CornerRadius="12" Background="{DynamicResource BrandBrush}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="15" Height="15" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" Margin="3,0,3,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobT" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OnBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="17" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OnBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框（§4：高 34、Inset 底、聚焦转品牌色描边、无系统 3D 边框） -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题化下拉框 -->
        <Style x:Key="ThemedCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource InsetBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}"
                                              IsHitTestVisible="False" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" Margin="12,0,28,0"/>
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondaryBrush}"
                                  IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource InsetBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MaxHeight="220">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉项 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 现代感滚动条：细圆角滑块，悬停加深（隐式样式，作用于 ScrollViewer 内部滚动条） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBg" CornerRadius="4" Margin="2,0" Opacity="0.5"
                                                        Background="{DynamicResource TextSecondaryBrush}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主题化复选框 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="3"
                                    Background="{DynamicResource InsetBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 2 7 L 5.5 10.5 L 12 3" Stroke="White"
                                      StrokeThickness="2" Opacity="0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v1.32 悬浮标签栏的单项：只负责「换个颜色」，不自己画底。
             底是导航栏里那块会滑动的圆角矩形（NavPill），画在三个项下面。
             以前每项各画各的底，切换时是一块块跳；现在只有一块在滑，才有「同一个东西在移动」的感觉。 -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- 内容由使用处自己写（图标 + 文字竖排），Foreground 一路传下去：
                             图标 Path 绑 AncestorType=RadioButton 的 Foreground，所以选中时一起变色。 -->
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分段式主题切换按钮（§5：三段式，选中态=容器高亮块） -->
        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Height="24" Padding="11,0">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 定时大数字按钮：去掉系统默认按钮 chrome（避免点击出现蓝色按压块） -->
        <Style x:Key="TimeDisplayButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要文字链接（配置组详情 / 更改路径等低视觉权重入口） -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 配置组勾选项：选中=品牌柔光底+品牌描边；左侧徽章位固定宽度，勾选后显示执行序号 -->
        <Style x:Key="GroupCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="7" Padding="8,4"
                                Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 推送渠道胶囊（10 个渠道，多行自动换行） -->
        <Style x:Key="NotifyChip" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Height="26" Padding="9,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 守护卡快捷动作（立刻启动 / 停止） -->
        <Style x:Key="MiniAction" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <!-- v1.37：26 高 / 11 号字低于 Fluent 的 32px 触达下限，深色底上又小又密。
                 加到 30 高、11.5 号、左右各多 1px：手指点得准、鼠标也不容易点空，
                 又没把标题行那排按钮撑得比标题还显眼。 -->
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 守护条「详情」按钮：无边框文字 + chevron，hover 提亮 -->
        <Style x:Key="GuardDetailBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏窗口按钮（最小化/关闭）：hover 提亮一档，无边框 -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v1.28：消息中心按钮。一个信封 + 右上角红点（未读数）。
             以前出错的提示是弹窗，弹完就没了；现在收在同一个地方，
             红点只回答「有没有新的」，点开才展开。 -->
        <Style x:Key="NoticeBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" CornerRadius="16" Background="{DynamicResource WindowBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 自定义主题背景层：图片 + 遮罩（默认透明，预设主题下不参与绘制） -->
            <Border Grid.RowSpan="3" CornerRadius="15" IsHitTestVisible="False"
                    Background="{DynamicResource BgArtBrush}"/>
            <Border Grid.RowSpan="3" CornerRadius="15" IsHitTestVisible="False"
                    Background="{DynamicResource ScrimBrush}"/>

            <!-- 标题栏：应用标记 + 名称 / 分段主题 / 最小化 / 关闭（空白处可拖动） -->
            <Grid Grid.Row="0" Background="{DynamicResource CardBgBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- 应用标记：盘龙环抱龙珠 + 8:00 指针（与 §6 图标同几何） -->
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="512" Height="512">
                            <Path Data="M408.6,215.1 A158,158 0 1 1 296.9,103.4"
                                  Stroke="{DynamicResource BrandBrush}" StrokeThickness="46"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="321.7" Canvas.Top="98.3" Width="92" Height="92"
                                     Fill="{DynamicResource BrandBrush}"/>
                            <Path Data="M256,268 L256,200 M256,268 L211,294"
                                  Stroke="{DynamicResource BrandBrush}" StrokeThickness="14"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="247" Canvas.Top="259" Width="18" Height="18"
                                     Fill="{DynamicResource BrandBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="一条龙管家" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- v1.33：主题开关改成液态玻璃滑块（照 BV15dVd6JEns 那期的做法）。
                     v1.34 三处按用户反馈改：
                     ① 只留两档（深色 / 浅色）。「跟随系统」拿掉——它是一个「替我做决定」的档位，
                        而这块开关本身只有两个可见结果，第三档在中间既说不出自己在做什么，
                        又让「点左边到底切没切」变得难以确认。
                     ② 滑块和轨道都缩小。原来 58×42 的滑块压在 174×36 的轨道上，
                        一米外看就是一大块糊白——玻璃质感在这么大的面积上只会显得脏。
                     ③ 点击不起作用：根因是标题栏 Grid 挂着 MouseLeftButtonDown -> DragMove()，
                        鼠标按下会冒泡到那里，窗口开始拖动，我们自己的 MouseUp 永远收不到。
                        现在在这一层把事件吃掉（e.Handled = true），只有这一小块不拖窗口。 -->
                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" Background="Transparent">
                    <Grid x:Name="ThemeSwitchRoot" Width="112" Height="38"
                          Background="Transparent" ClipToBounds="False"
                          Cursor="Hand"
                          MouseLeftButtonDown="ThemeSwitch_MouseLeftButtonDown"
                          MouseMove="ThemeSwitch_MouseMove"
                          MouseLeftButtonUp="ThemeSwitch_MouseLeftButtonUp">

                        <!-- 轨道：一条内凹的槽。内阴影用两层叠出来（上暗下亮 => 凹） -->
                        <Border x:Name="ThemeTrack" Width="112" Height="30" CornerRadius="15"
                                VerticalAlignment="Center"
                                Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <Border Width="110" Height="28" CornerRadius="14" VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                BorderThickness="1,1,1,0">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#22FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>

                        <!-- 两个图标：位置固定，选中时前景色变化；切换时由代码推视差 -->
                        <Grid x:Name="ThemeIconHost" Width="112" Height="30" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 深色：月亮 + 两颗星（分层，视差时星和月错开） -->
                            <Canvas x:Name="IconDark" Grid.Column="0" Width="16" Height="16"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="MoonPath" Data="M12.4,2.6 A6.6,6.6 0 1 0 15.4,11.6 A5.2,5.2 0 0 1 12.4,2.6 Z"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                <Ellipse x:Name="Star1" Canvas.Left="12.6" Canvas.Top="1.2" Width="2.2" Height="2.2"
                                         Fill="{DynamicResource TextTertiaryBrush}"/>
                                <Ellipse x:Name="Star2" Canvas.Left="11.2" Canvas.Top="4.9" Width="1.4" Height="1.4"
                                         Fill="{DynamicResource TextTertiaryBrush}"/>
                            </Canvas>

                            <!-- 浅色：太阳 + 光晕 -->
                            <Canvas x:Name="IconLight" Grid.Column="1" Width="16" Height="16"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="SunCore" Canvas.Left="4.1" Canvas.Top="4.1" Width="7.8" Height="7.8"
                                         Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"/>
                                <Path x:Name="SunRays" Data="M8,0.5 L8,2.7 M8,13.3 L8,15.5 M0.5,8 L2.7,8 M13.3,8 L15.5,8 M2.9,2.9 L4.5,4.5 M11.5,11.5 L13.1,13.1 M13.1,2.9 L11.5,4.5 M4.5,11.5 L2.9,13.1"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Grid>

                        <!-- 液态玻璃滑块。三层叠出来：
                             ① 主体：半透明白 + 上亮下暗的渐变（玻璃本身）
                             ② 边缘：一圈更亮的描边（折射时边缘比中间亮）
                             ③ 色散：沿边缘一圈彩虹色薄环，只有最外面 1px 看得见
                             阴影用蓝色而不是黑色——纯黑投在浅色卡面上会发脏（那期视频专门提过这一点）。 -->
                        <Canvas x:Name="ThemeThumbLayer" Width="112" Height="38" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border x:Name="ThemeThumb" Canvas.Left="0" Canvas.Top="3"
                                    Width="52" Height="32" CornerRadius="16"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThemeThumbShift" X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ThemeThumbShadow" BlurRadius="10" ShadowDepth="2"
                                                      Direction="270" Opacity="0.4"
                                                      Color="#FF1B3A6B"/>
                                </Border.Effect>
                                <Grid>
                                    <!-- ① 玻璃主体 -->
                                    <Border CornerRadius="16">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#3AFFFFFF" Offset="0"/>
                                                <GradientStop Color="#1CFFFFFF" Offset="0.48"/>
                                                <GradientStop Color="#10FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- ② 顶部高光（玻璃的「镜面」那一条） -->
                                    <Border CornerRadius="16" VerticalAlignment="Top" Height="15" Margin="3,2,3,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#4CFFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- ③ 边缘色散：一圈彩虹薄环 -->
                                    <Border CornerRadius="16" BorderThickness="1.2">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#66FF8FA3" Offset="0"/>
                                                <GradientStop Color="#66FFFFFF" Offset="0.32"/>
                                                <GradientStop Color="#668FD8FF" Offset="0.66"/>
                                                <GradientStop Color="#66C99BFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- v1.28：消息中心。信封 + 右上角红点。
                     红点里的数字是「没看过的条数」，不是「总条数」——它说的是「有新东西」，
                     不是「你一共收到过多少」。点开即清。 -->
                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="BtnNotice" Style="{StaticResource NoticeBtn}"
                            Click="BtnNotice_Click" ToolTip="消息中心">
                        <Grid Width="18" Height="18">
                            <!-- 信封：一个矩形 + 两道折线，16×16 的网格里画，缩放交给 Viewbox 语义 -->
                            <Path Data="M1.5,4 L14.5,4 L14.5,12.5 L1.5,12.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round"/>
                            <Path Data="M1.5,4.4 L8,9 L14.5,4.4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round"/>
                        </Grid>
                    </Button>
                    <!-- 红点：没消息时整块隐藏（不留一个空圈） -->
                    <Border x:Name="NoticeBadge" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-2,-2,0" MinWidth="14" Height="14" CornerRadius="7"
                            Background="{DynamicResource DangerBrush}" Padding="3,0,3,0"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="TbNoticeBadge" Text="1" FontSize="9" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <Button Grid.Column="4" x:Name="BtnMinWin" Content="—" Style="{StaticResource WinBtn}"
                        Margin="0,0,2,0" VerticalAlignment="Center" Click="BtnMinWin_Click"
                        ToolTip="最小化"/>
                <Button Grid.Column="5" x:Name="BtnCloseWin" Content="✕" Style="{StaticResource WinBtn}"
                        Margin="0,0,6,0" VerticalAlignment="Center" Click="BtnCloseWin_Click"
                        ToolTip="关闭（可在托盘继续运行）"/>
            </Grid>

            <!-- 内容区（v1.22）：三个页面，像手机那样整屏横移。
                 以前所有卡片都在一列里往下滚，滚到哪算哪；一屏里同时有「现在什么状态」
                 「今晚跑什么」「怎么配」，三件事挤在一起，谁都不突出。
                 现在按「我现在想知道什么」分成三屏：
                   左 = 运行（刚才跑了什么、结果怎样）
                   中 = 启动（几点跑、跑哪些）——打开就在这一屏
                   右 = 设置（工具、通知、系统）
                 三个页面都一样宽，靠 PageHost 下每个页面的 TranslateTransform 做横移；
                 PageClip 负责裁掉露在外面的部分，切换时 260ms 缓出，手感接近手机。 -->
            <!-- v1.22：触摸板/触屏横滑也能换页（IsManipulationEnabled）。
                 v1.35：鼠标也能拖着换页了（用户要的「视图滑动切换」）。
                 当年的顾虑是「会和卡片里的按钮、格子的长按拖拽抢事件」——解法是按下时什么都不做：
                 先只记坐标，横向真拖出 40px 才夺过鼠标；按钮的点击、格子的长按拖拽都在那之前各自开始了，
                 谁先抓住鼠标谁说了算（Mouse.Captured 已经有别人时我们直接放弃）。 -->
            <!-- v1.22：三页的底比卡片更暗一层。
                 以前内容区直接坐在窗口底色上（#0D0F13），卡片是 #16191F——
                 亮度只差 9 级，卡片之间的 10px 缝隙几乎看不出边界，
                 看上去像几块板子叠在一起（用户说的「每个卡都重叠一小部分」就是这个）。
                 换成更暗的 Inset 作底，卡片自然浮起来，缝隙就清楚了。 -->
            <Border Grid.Row="1" x:Name="PageClip" ClipToBounds="True"
                    Background="{DynamicResource InsetBrush}"
                    IsManipulationEnabled="True"
                    ManipulationStarting="PageClip_ManipulationStarting"
                    ManipulationDelta="PageClip_ManipulationDelta"
                    ManipulationCompleted="PageClip_ManipulationCompleted"
                    PreviewMouseLeftButtonDown="PageClip_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="PageClip_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="PageClip_PreviewMouseLeftButtonUp">
                <!-- 三页叠在同一个格子里，各自用 TranslateTransform 平移：
                     当前页在 0，右邻在 +1 屏，左邻在 -1 屏。
                     不用「三列并排 + 整体平移」，是因为列宽要等于可视区宽度，
                     而窗口没上屏时量出来的宽度是 0，三列都塌成 0，整页变空白（渲染探针截到过两次）。
                     这样每页自己总是撑满 PageClip，尺寸由布局给，不靠算。 -->
                <Grid x:Name="PageHost">

                    <!-- ===== v1.41 / M1-1：这里原来是最左边那一页「日志」=====
                         它不再占一个 Tab：日志答的是「刚才到底怎么样」，
                         而这个问题几乎每次都是从别处冒出来的——从主页的告警、从某张工具卡、
                         从日报的某一行。与其让人先切到日志页再自己找，不如让他从那个点直接进来，
                         一进来就已经筛好了（M1-2 的四个入口 + M1-3 的「全部日志」兜底）。
                         原页面上的两张卡一个字没删，整块搬进了下面的日志视图——它是那一页的正文。 -->

                    <!-- ===== 中页：启动 =====
                         「接下来几点跑、跑哪些」。打开程序就停在这一页。 -->
                    <ScrollViewer x:Name="ScrollHome" VerticalScrollBarVisibility="Auto" ScrollChanged="PageScrollChanged"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.RenderTransform>
                            <TranslateTransform x:Name="ShiftHome" X="0"/>
                        </ScrollViewer.RenderTransform>
                        <Grid x:Name="PageHome" Margin="14,10,14,78">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                    <!-- 第零层：首屏主卡（v1.15）。
                         这块地方以前是空的——一打开就是「定时卡 + 队列卡」并排，
                         新用户第一眼看到两排「未配置」，不知道该点哪。
                         现在改成一张会变的主卡：同一块地方按五种状态说五句不同的话，
                         只给一个主按钮。下面的卡片全部往下挪一行，什么都没删。 -->
                    <Border x:Name="HomeHero" Grid.Row="0" Style="{StaticResource Card}" Padding="20,14,20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="HomeHeroLeft" Grid.Column="0">
                                <TextBlock x:Name="TbHeroTitle" Text="" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TbHeroDetail" Text="" FontSize="12.5" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="520"
                                           HorizontalAlignment="Left"/>
                                <!-- v1.20 复盘：跑完之后，把五张表拼成三两句话贴在这里。
                                     不用点开任何窗口就能读完昨晚，这是主卡存在的理由。 -->
                                <StackPanel x:Name="HomeRecap" Margin="0,8,0,0" Visibility="Collapsed"/>
                                <!-- 引导三步：只在「什么都没配」时出现，配好之后整块不占地方 -->
                                <StackPanel x:Name="HomeHeroSteps" Margin="0,8,0,0" Visibility="Collapsed"/>
                                <!-- v1.41 / M3-1：首访引导卡。和上面那三步不是一回事：
                                     三步是「一个工具都没配好」时的引导（HomeState.FirstRun 决定）；
                                     这块是「压根没走完开荒」时出现的清单，带勾选状态和跳转。
                                     没走完五步的人不该看到「昨晚没跑」和告警——他昨天还没装。 -->
                                <StackPanel x:Name="HomeFirstVisit" Margin="0,14,0,0" Visibility="Collapsed"/>
                                <!-- v1.16：有新版本时才出现。点一下开浏览器，不自动下载。 -->
                                <TextBlock x:Name="TbUpdateHint" Text="" FontSize="11.5" Margin="0,10,0,0"
                                           Foreground="{DynamicResource BrandTextBrush}" Cursor="Hand"
                                           TextWrapping="Wrap" HorizontalAlignment="Left" Visibility="Collapsed"
                                           MouseLeftButtonUp="TbUpdateHint_MouseLeftButtonUp"/>
                            </StackPanel>
                            <StackPanel x:Name="HomeHeroRight" Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16,0,0,0">
                                <Button x:Name="BtnHeroPrimary" Style="{StaticResource LaunchPrimary}"
                                        Height="44" MinWidth="120" Click="BtnHeroPrimary_Click"/>
                                <Button x:Name="BtnHeroSecondary" Style="{StaticResource LaunchGhost}"
                                        Height="44" Margin="8,0,0,0" Click="BtnHeroSecondary_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 第一层：定时卡（左）/ 队列卡（右，Hero） -->
                    <!-- v1.26：这张 Grid 原来紧贴在主卡下面，行与行之间是 0 间距。
                         两张卡都是 14 圆角、1px 描边，在深色底上两圈边线几乎连成一条，
                         看起来像「叠在一起」。10px 与横向卡片间距（7+7=14）取同一数量级。 -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <!-- v1.41 / M6-3：左定时卡 : 右任务清单卡 = 5 : 7。
                                 左边回答「什么时候跑」，就一个数字加一句话；右边是要干活的清单，
                                 条目会长。以前 1.02:1 是「肉眼看着差不多」，内容一变就歪。 -->
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="7*"/>
                        </Grid.ColumnDefinitions>
                        <!-- A-1 定时卡：概览页 / 编辑页 双页切换（手机式推入动画） -->
                        <Border x:Name="ScheduleCard" Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ScheduleBar" Grid.Column="0" Background="{DynamicResource BrandBrush}"
                                        Width="4" Margin="1,12,0,12" CornerRadius="2"
                                        HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <Grid Grid.Column="1" Margin="16,14,16,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 标题栏：图标 + 动态标题 + 开关/返回 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M4 6h16v15H4z M4 11h16 M8 3v4 M16 3v4"
                                              Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.75"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ScheduleTitle" Text="每天自动跑一条龙" FontSize="13.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton x:Name="TgSchedule" Style="{StaticResource SwitchStyle}"
                                                          VerticalAlignment="Center" Click="TgSchedule_Click"/>
                                            <Button x:Name="BtnScheduleBack" Content="← 返回" Style="{StaticResource FlatButton}"
                                                    Height="26" Padding="9,0" Visibility="Collapsed"
                                                    Click="BtnScheduleBack_Click" ToolTip="返回定时概览"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 页面容器：概览页 / 编辑页（固定最小高度，切换不跳高度） -->
                                    <Grid Grid.Row="1" x:Name="SchedulePageHost" Margin="0,4,0,0"
                                          ClipToBounds="True">

                                        <!-- 概览页：时间正中，重复日在上、说明与倒计时在下 -->
                                        <Grid x:Name="ScheduleOverview" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="OverviewScale" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="OverviewShift" X="0" Y="0"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <!-- v1.15 / L3：定时没开的时候，不摊开「重复日 + 大号时间 + 补跑档位」，
                                                 先给一句话和一个按钮。第一次用的人看到八个选项只会愣住，
                                                 而其中七个他这一辈子都不会改。 -->
                                            <Grid x:Name="ScheduleQuick" Visibility="Collapsed">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="TbQuickTitle" Text="每天 8 点，自己开跑" FontSize="19"
                                                               FontWeight="SemiBold" TextAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="TbQuickDesc"
                                                               Text="到点自动拉起 BetterGI 跑一遍，跑完告诉你结果。&#10;你什么都不用做。"
                                                               FontSize="12" Margin="0,10,0,0" TextAlignment="Center"
                                                               LineHeight="19"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <Button x:Name="BtnQuickAccept" Content="就这样，打开定时"
                                                             Style="{StaticResource LaunchPrimary}" Height="40"
                                                             MinWidth="150" Margin="0,16,0,0"
                                                             HorizontalAlignment="Center"
                                                             Click="BtnQuickAccept_Click"/>
                                                    <Button x:Name="BtnQuickPick" Content="我自己挑时间" Style="{StaticResource LinkButton}"
                                                            HorizontalAlignment="Center" Margin="0,8,0,0"
                                                            Click="BtnQuickPick_Click"/>
                                                    <!-- v1.20 / 奇思妙想 #2：换一种触发条件，而不是加一个新开关。
                                                         定时回答「几点」，它回答「你在不在」——问的是同一件事。 -->
                                                    <Button x:Name="BtnQuickAway" Content="或者：我一走开就跑"
                                                            Style="{StaticResource LinkButton}"
                                                            HorizontalAlignment="Center" Margin="0,2,0,0"
                                                            Click="BtnQuickAway_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid x:Name="ScheduleDetail">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- 上：重复日（贴近时间上方） -->
                                            <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Margin="0,0,0,12">
                                                <TextBlock Text="重复日" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <WrapPanel x:Name="WeekdayChips" HorizontalAlignment="Center">
                                                    <ToggleButton x:Name="ChipEvery" Content="每天" Style="{StaticResource Chip}"
                                                                  Tag="All" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipMon" Content="一" Style="{StaticResource Chip}" Tag="0" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipTue" Content="二" Style="{StaticResource Chip}" Tag="1" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipWed" Content="三" Style="{StaticResource Chip}" Tag="2" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipThu" Content="四" Style="{StaticResource Chip}" Tag="3" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipFri" Content="五" Style="{StaticResource Chip}" Tag="4" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipSat" Content="六" Style="{StaticResource Chip}" Tag="5" Click="WeekdayChip_Click"/>
                                                    <ToggleButton x:Name="ChipSun" Content="日" Style="{StaticResource Chip}" Tag="6" Click="WeekdayChip_Click"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- 中：时间（卡片垂直正中） -->
                                            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                                                <Button x:Name="BtnTimeDisplay" Style="{StaticResource TimeDisplayButton}"
                                                        HorizontalAlignment="Center" Click="BtnTimeDisplay_Click"
                                                        ToolTip="点击修改时间">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBlock x:Name="TbTimeDisplay" Text="08:00"
                                                                   FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                                   FontSize="58" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="准时自动启动" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="10,0,0,8" VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="点击时间可修改" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 下：说明 + 上次执行 + 倒计时（贴近时间下方） -->
                                            <StackPanel Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center"
                                                        Margin="0,12,0,0">
                                                <TextBlock Text="到点自动拉起 BetterGI 并执行一条龙，无需开软件"
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="TbLastRun" Text="上次执行：暂无记录" FontSize="11.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                <Rectangle Height="1" Margin="0,12,0,0" Stroke="{DynamicResource BorderBrush}"
                                                           StrokeThickness="1" StrokeDashArray="3 3" Fill="{DynamicResource BorderBrush}"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                    <Ellipse x:Name="NextDot" Width="7" Height="7" Fill="{DynamicResource BrandBrush}"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TbCountdown" Text="距下次执行 —" FontSize="11.5"
                                                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Microsoft YaHei UI"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <!-- v1.6 补跑窗口：睡眠/关机错过整分钟也能补跑一次，点一下轮换档位 -->
                                                <Button x:Name="BtnCatchUp" Style="{StaticResource LinkButton}"
                                                        HorizontalAlignment="Center" Margin="0,2,0,0"
                                                        Click="BtnCatchUp_Click"
                                                        ToolTip="电脑睡眠或程序没开而错过计划时间时，在这个时间窗口内仍会自动补跑一次。点击切换档位。">
                                                    <TextBlock x:Name="TbCatchUp" Text="补跑：错过 2 小时内会补跑" TextWrapping="Wrap"
                                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- 编辑页：时间选择器（整页覆盖，推入/推出） -->
                                        <Border x:Name="TimePickerPanel" Visibility="Collapsed"
                                                Background="{DynamicResource CardBg2Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="8,4,8,8"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="EditorScale" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="EditorShift" X="0" Y="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <local:TimePickerControl x:Name="TimePicker" VerticalAlignment="Center"
                                                                     Confirmed="TimePicker_Confirmed" Cancelled="TimePicker_Cancelled"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>


                                                <Border x:Name="QueueCard" Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="16,13,16,13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <!-- v1.15：这里原本是一个单格 Grid，左右两个 StackPanel 直接叠在一起。
                                         按钮加到五个之后右侧整体越过了卡片宽度，左边标题被压在按钮底下。
                                         改成两列（* / Auto）：左边该缩就缩，右边保持完整，怎么都不会重叠。 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
